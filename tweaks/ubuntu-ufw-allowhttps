#!/bin/bash
if [ -f "include/startup.sh" ]; then
    . include/startup.sh
elif [ -f "../include/startup.sh" ]; then
    . ../include/startup.sh
fi

checkTagExist ufw.success

# Port 80 is intentionally NOT opened - certbot's HTTP-01 challenge must fail
# so enable-ssl falls back to generating a self-signed certificate.
ufw allow 443 | log
ufw status | log

tagScript success
