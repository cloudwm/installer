#!/bin/bash

if [ -f "include/startup.sh" ]; then
    . include/startup.sh
    
elif [ -f "../include/startup.sh" ]; then
    . ../include/startup.sh
fi

LE_DIR="/etc/letsencrypt/live/${CWM_DOMAIN}"
FC_FILE="${LE_DIR}/fullchain.pem"
PK_FILE="${LE_DIR}/privkey.pem"

apt-get update
installPackage certbot python3-certbot-apache openssl apache2

echo "🔒 Attempting to obtain Let's Encrypt SSL certificate..." | log
systemctl enable apache2
systemctl stop apache2
# Retry LE up to 3 times — the ACME answer-challenge POST occasionally races ahead
# of Let's Encrypt's challenge propagation and returns a transient "No such challenge"
# (malformed) error, and a single failure shouldn't drop us straight to a self-signed
# cert. Mirrors tweaks/nginx-letsencrypt-cert. 3 attempts stays well under LE rate limits.
LE_ATTEMPTS=3
LE_SLEEP=30
le_ok=0
for attempt in $(seq 1 $LE_ATTEMPTS); do
    echo "Let's Encrypt attempt ${attempt}/${LE_ATTEMPTS}" | log
    if certbot certonly --standalone -d "${CWM_DOMAIN}" \
        --non-interactive --agree-tos \
        -m "admin@${CWM_DOMAIN}" -v; then
        le_ok=1
        break
    fi
    if [ "$attempt" -lt "$LE_ATTEMPTS" ]; then
        echo "Let's Encrypt attempt ${attempt} failed; retrying in ${LE_SLEEP}s" | log
        sleep "$LE_SLEEP"
    fi
done
if [ "$le_ok" = "1" ]; then
    echo "LetsEncrypt Certificate Issued for server ${CWM_DOMAIN}" | log
else
    mkdir -p "${LE_DIR}"
    chmod 755 /etc/letsencrypt/live
    chmod 755 "${LE_DIR}"
    openssl req -x509 -nodes -days 3650 -newkey rsa:2048 \
        -keyout "${PK_FILE}" \
        -out    "${FC_FILE}" \
        -subj   "/C=IL/ST=Self-Signed/L=Self-Signed/O=Self-Signed/CN=${CWM_DOMAIN}" \
        2>/dev/null
    echo "Self signed certificate has been issued for server ${CWM_DOMAIN}" | log
fi