#!/bin/bash

# Add this at the begining of all scripts.
if [ -f "include/startup.sh" ]; then
    . include/startup.sh
elif [ -f "../include/startup.sh" ]; then
    . ../include/startup.sh
fi

execSpecial 3 '(fail|error)' certbot certonly -n --standalone --preferred-challenges http --agree-tos --email ${ADMINEMAIL} -d ${CWM_DOMAIN} ${CWM_DEBUG:+"--test-cert"}
###OREN CHANGES###
if [[ $? == 1 ]]
then
export certbot_failed=1
echo "Certbot failed. Generating self-signed certificate for ${CWM_DOMAIN}" | log

liveDir="/etc/letsencrypt/live/${CWM_DOMAIN}"
mkdir -p "${liveDir}"

# A bare CN is ignored by every modern TLS client - the domain has to appear in a
# subjectAltName extension. Passing it via a config file instead of -addext keeps
# this working on OpenSSL 1.0.x, where -addext does not exist.
sanConf=$(mktemp)
cat > "${sanConf}" <<EOF
[req]
prompt             = no
distinguished_name = dn
x509_extensions    = v3_req
[dn]
CN = ${CWM_DOMAIN}
[v3_req]
subjectAltName   = DNS:${CWM_DOMAIN}
basicConstraints = CA:FALSE
keyUsage         = digitalSignature, keyEncipherment
extendedKeyUsage = serverAuth
EOF

openssl req -x509 -sha256 -newkey rsa:2048 -nodes -days 1024 -config "${sanConf}" -keyout "${liveDir}/privkey.pem" -out "${liveDir}/fullchain.pem"
waitOrStop 0 "Certificate creation failed"
rm -f "${sanConf}"

# Mirror the file set certbot produces. Consumers that reference cert.pem or
# chain.pem then find a real file; a missing one makes Docker create a directory
# at the mount target, which silently kills the web server that reads it.
cp "${liveDir}/fullchain.pem" "${liveDir}/cert.pem"
cp "${liveDir}/fullchain.pem" "${liveDir}/chain.pem"
chmod 600 "${liveDir}/privkey.pem"
ls -l "${liveDir}" | log


else
export certbot_failed=0
#waitOrStop 0 "Failed certbot certificate generation"
fi

export CWM_DISPLAYED_ADDRESS="${CWM_DOMAIN}"
tag global-domain-set.success

tag ssl-ready.success
tagScript success

exit 0
