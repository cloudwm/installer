#!/bin/bash

# Add this at the begining of all scripts.
if [ -f "include/startup.sh" ]; then
    . include/startup.sh
elif [ -f "../include/startup.sh" ]; then
    . ../include/startup.sh
fi
ADDONS_DIR="/opt/microk8s-addons/microk8s-core-addons"
ADDONS_REPO="https://github.com/cloudwm/microk8s-core-addons.git"
ADDONS_BRANCH="hay-refactor"

checkTagExist ubuntu-updateos.success

rootDir=$(rootDir)

echo "Purging old snapd and installing snapd + jq" | log
# fix for snap
apt purge snapd -y
apt install snapd jq -y
waitOrStop 0 "snap install failed"

echo "Installing microk8s snap" | log
snap install microk8s --classic --channel=1.32
waitOrStop 0 "snap install failed"

echo "Generating Provider Secret" | log
cat << EOF > guest.yaml
apiVersion: v1
kind: Secret
metadata:
  name: provider-guest-secret
  namespace: kube-system
type: Opaque
data:
EOF

echo "Copying guest.conf and encoding values into guest.yaml" | log
cp /root/guest.conf $rootDir/guest.conf

cat $rootDir/guest.conf | awk -F  '=' ' {cmd="printf %s "$2" | base64 -w 0";cmd| getline x;close(cmd);print "  "$1": "x }' >> $rootDir/guest.yaml
export apiClientId=`cat $rootDir/guest.conf | grep apiClientId | cut -d '=' -f 2`
export apiSecret=`cat $rootDir/guest.conf | grep apiSecret | cut -d '=' -f 2`
export apiUrl=`cat $rootDir/guest.conf | grep url | cut -d '=' -f 2`
export apiZone=`cat $rootDir/guest.conf | grep 'zone=' | cut -d '=' -f 2`
echo "Authenticating against provider API" | log
export apiToken=`curl -X POST --url "https://${apiUrl}/service/authenticate" -H "content-type: application/json" -d "{\"clientId\": \"${apiClientId}\",\"secret\": \"${apiSecret}\"}" | jq -r .authentication`

echo "Fetching server metadata from provider API" | log
curl -o $rootDir/server.json -X GET --url "https://${apiUrl}/service/server" -H "content-type: application/json" -H "Authorization: Bearer ${apiToken}"
export imageIDRaw=`cat $rootDir/server.json  | jq '.diskImages | .["'"$apiZone"'"]' | jq -r '.[] |  select( [ .description | contains("ubuntu_server_24.04_64-bit") ] | any) | .id'`
export trafficPackageRaw=`cat $rootDir/server.json  | jq '.traffic | .["'"$apiZone"'"]'  | jq -r '.[] |  select( [ .info | contains("traffic") ] | any) | .name'`

if [ -z "$imageIDRaw" ] || [ "$imageIDRaw" = "null" ]; then
    echo "ERROR: imageID lookup returned empty for zone '$apiZone' (ubuntu_server_24.04_64-bit)" | log
    exit 1
fi
if [ -z "$trafficPackageRaw" ] || [ "$trafficPackageRaw" = "null" ]; then
    echo "ERROR: trafficPackage lookup returned empty for zone '$apiZone'" | log
    exit 1
fi

export imageID=`printf %s "$imageIDRaw" | base64 -w 0`
export trafficPackage=`printf %s "$trafficPackageRaw" | base64 -w 0`
echo "  imageid: $imageID" >> $rootDir/guest.yaml
echo "  trafficpackage: $trafficPackage" >> $rootDir/guest.yaml

echo "Applying provider secret to kube-system namespace" | log
microk8s kubectl apply -f $rootDir/guest.yaml
waitOrStop 0 "Unable to apply provider secret"

echo "Modifying microk8s repository" | log


mkdir -p /opt/microk8s-addons

echo "Cloning microk8s addons repository (${ADDONS_BRANCH})" | log
rm -rf "${ADDONS_DIR}"

git clone -b "${ADDONS_BRANCH}" \
  "${ADDONS_REPO}" \
  "${ADDONS_DIR}"

waitOrStop 0 "Failed to clone microk8s addons repository"

echo "Replacing default microk8s addons repo with core-fork" | log
microk8s addons repo remove core-fork || true
microk8s addons repo remove core || true

microk8s addons repo add core-fork "${ADDONS_DIR}"

waitOrStop 0 "Repository addition failed"


echo "Generating admin-user and login token" | log
cat << EOF > $rootDir/user.yaml
apiVersion: v1
kind: ServiceAccount
metadata:
  name: admin-user
  namespace: kube-system

---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: admin-user
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: cluster-admin
subjects:
- kind: ServiceAccount
  name: admin-user
  namespace: kube-system

---
apiVersion: v1
kind: Secret
metadata:
  name: admin-user
  namespace: kube-system
  annotations:
    kubernetes.io/service-account.name: "admin-user"   
type: kubernetes.io/service-account-token  
EOF
echo "Applying admin-user yaml to cluster" | log
microk8s kubectl apply -f $rootDir/user.yaml
waitOrStop 0 "Unable to apply admin-user yaml"

export CWM_SERVERIP=`hostname -I | awk '{print $1}'`
export CWM_DOMAIN="${CWM_SERVERIP//./-}.cloud-xip.com"

echo "Cloning dashboard repository" | log
cd $rootDir && git clone https://github.com/cloudwm/k8s-dashboard.git -b hay-refactor
waitOrStop 0 "Clone k8s-dashboard repository failed"

echo "Downloading helm dependencies" | log
cd $rootDir/k8s-dashboard/charts/kubernetes-dashboard
microk8s helm repo add ingress-nginx https://kubernetes.github.io/ingress-nginx
microk8s helm repo add jetstack.io https://charts.jetstack.io
microk8s helm repo add kubernetes-sigs https://kubernetes-sigs.github.io/metrics-server/
microk8s helm repo add kong https://charts.konghq.com
microk8s helm dependency build
waitOrStop 0 "dependency build failed"

echo "Patching dashboard values.yaml with domain and server IP" | log
sed -i 's/0.0.0.0/'"$CWM_DOMAIN"'/' values.yaml
sed -i 's/1.1.1.1/'"$CWM_SERVERIP"'/' values.yaml

echo "Installing dashboard helm chart" | log
microk8s helm install dashboard . --namespace kube-system
waitOrStop 0 "Dashboard install failed"

echo "Expose Kubernetes Dashboard through internal NGINX ingress" | log
cat <<'EOF' | microk8s kubectl apply -f -
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: dashboard-web-ingress
  namespace: kube-system
  annotations:
    nginx.ingress.kubernetes.io/backend-protocol: "HTTP"
spec:
  ingressClassName: internal-nginx
  rules:
    - http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: dashboard-kubernetes-dashboard-web
                port:
                  number: 8000
EOF
waitOrStop 0 "Dashboard ingress apply failed"

echo "Retrieving admin-user token from cluster" | log
export ADMINTOKEN=`microk8s kubectl get secret admin-user -n kube-system -o jsonpath="{.data.token}" | base64 -d && echo`


echo "Adding descriptions" | log
descriptionAppend "Kubernetes Dashboard UI: https://${CWM_DOMAIN}/"
descriptionAppend " "
descriptionAppend "Kubernetest admin-user token: ${ADMINTOKEN}"
descriptionAppend " "

echo "Tagging script as success" | log
tagScript success

exit 0
