#!/bin/bash

# Add this at the begining of all scripts.
if [ -f "include/startup.sh" ]; then
    . include/startup.sh
elif [ -f "../include/startup.sh" ]; then
    . ../include/startup.sh
fi

echo "Checking ubuntu-updateos.success tag" | log
checkTagExist ubuntu-updateos.success

echo "Setting root directory" | log
rootDir=$(rootDir)

echo "Purging existing snapd" | log
# fix for snap
apt purge snapd -y
echo "Installing snapd and jq packages" | log
apt install snapd jq -y
waitOrStop 0 "snap install failed"

echo "Installing microk8s snap" | log
# Channel comes as a request parameter (CWM_MICROK8SCHANNEL); default to 1.35 if not provided
microk8sChannel="${CWM_MICROK8SCHANNEL:-1.35}"
echo "Using microk8s channel: ${microk8sChannel}" | log
snap install microk8s --classic --channel="${microk8sChannel}"
waitOrStop 0 "snap install failed"

# Let microk8s fully come up first. The first start sideloads the bundled images
# (calico/cni, calico/node, ...) into containerd; restarting mid-sideload (below)
# corrupts the content store and breaks the calico image pull. Wait for ready
# BEFORE touching the kubelet args and restarting.
echo "Waiting for MicroK8s to be ready before changing kubelet args" | log
microk8s status --wait-ready

# Pin the kubelet node name to the first label of the hostname (everything
# before the first dot), so a hostname change after a reboot (e.g. "hay.k8s"
# -> "hay") does not make kubelet re-register under a new name and leave a
# stale node behind.
echo "Pinning kubelet node name via --hostname-override" | log
NODE_NAME="$(hostname | cut -d. -f1)"
echo "Using node name: ${NODE_NAME}" | log
if ! grep -q -- "--hostname-override=" /var/snap/microk8s/current/args/kubelet; then
  echo "--hostname-override=${NODE_NAME}" >> /var/snap/microk8s/current/args/kubelet
else
  sed -i 's#--hostname-override=.*#--hostname-override='"${NODE_NAME}"'#' /var/snap/microk8s/current/args/kubelet
fi
# Configure containerd to pull docker.io images through the Harbor mirror
# first, falling back to docker.io only when Harbor misses or is unreachable.
# containerd tries the listed [host] entries in order, then the canonical
# "server" last. override_path is required because the Harbor URL already
# carries the proxy-cache path (/v2/dockerhub); without it containerd would
# append its own /v2/ and break the request.
echo "Configuring docker.io registry mirror via Harbor" | log
DOCKERIO_CERTS_DIR="/var/snap/microk8s/current/args/certs.d/docker.io"
mkdir -p "${DOCKERIO_CERTS_DIR}"
cat << 'EOF' > "${DOCKERIO_CERTS_DIR}/hosts.toml"
server = "https://registry-1.docker.io"

[host."https://harbor-us-ny2.cloudwm.com/v2/dockerhub"]
  capabilities = ["pull", "resolve"]
  override_path = true
EOF

microk8s stop
microk8s start
waitOrStop 0 "Failed to restart microk8s after setting hostname-override"

echo "Generating Provider Secret" | log
cat << EOF > guest.yaml
apiVersion: v1
kind: Secret
metadata:
  name: provider-guest-secret
  namespace: kube-system
type: Opaque
data:
EOF

echo "Copying guest.conf to root directory" | log
cp /root/guest.conf $rootDir/guest.conf

echo "Encoding guest.conf values into guest.yaml" | log
cat $rootDir/guest.conf | awk -F  '=' ' {cmd="echo "$2" | base64";cmd| getline x;close(cmd);print "  "$1": "x }' >> $rootDir/guest.yaml
echo "Exporting API credentials from guest.conf" | log
export apiClientId=`cat $rootDir/guest.conf | grep apiClientId | cut -d '=' -f 2`
export apiSecret=`cat $rootDir/guest.conf | grep apiSecret | cut -d '=' -f 2`
export apiUrl=`cat $rootDir/guest.conf | grep url | cut -d '=' -f 2`
export apiZone=`cat $rootDir/guest.conf | grep 'zone=' | cut -d '=' -f 2`
echo "Authenticating against API to retrieve token" | log
export apiToken=`curl -X POST --url "https://${apiUrl}/service/authenticate" -H "content-type: application/json" -d "{\"clientId\": \"${apiClientId}\",\"secret\": \"${apiSecret}\"}" | jq -r .authentication`
echo "Fetching server.json from API" | log
curl -o $rootDir/server.json -X GET --url "https://${apiUrl}/service/server" -H "content-type: application/json" -H "Authorization: Bearer ${apiToken}"
echo "Extracting imageID and trafficPackage from server.json" | log
export imageID=`cat $rootDir/server.json  | jq '.diskImages | .["'"$apiZone"'"]' | jq -r '.[] |  select( [ .description | contains("ubuntu_server_24.04_64-bit") ] | any) | .id' | base64`
export trafficPackage=`cat $rootDir/server.json  | jq '.traffic | .["'"$apiZone"'"]'  | jq -r '.[] |  select( [ .info | contains("traffic") ] | any) | .name' | base64`
echo "Appending imageid and trafficpackage to guest.yaml" | log
echo "  imageid: $imageID" >> $rootDir/guest.yaml
echo "  trafficpackage: $trafficPackage" >> $rootDir/guest.yaml
echo "Applying provider secret to cluster" | log
echo "Waiting for MicroK8s API to be ready" | log
microk8s status --wait-ready

until microk8s kubectl get nodes >/dev/null 2>&1; do
  echo "Waiting for Kubernetes API..." | log
  sleep 5
done

# Wait for our (correctly named) node to register and become Ready.
echo "Waiting for node ${NODE_NAME} to be Ready" | log
until microk8s kubectl get node "${NODE_NAME}" \
        -o jsonpath='{range .status.conditions[?(@.type=="Ready")]}{.status}{end}' 2>/dev/null \
        | grep -q "True"; do
  echo "Waiting for node ${NODE_NAME} to become Ready..." | log
  sleep 5
done

# Remove any stale node registered under the old hostname (e.g. the FQDN the
# kubelet used before --hostname-override took effect). Single-node install, so
# anything that is not NODE_NAME is an orphan.
echo "Removing stale node entries (anything other than ${NODE_NAME})" | log
for staleNode in $(microk8s kubectl get nodes -o jsonpath='{.items[*].metadata.name}'); do
  if [ "${staleNode}" != "${NODE_NAME}" ]; then
    echo "Deleting stale node: ${staleNode}" | log
    microk8s kubectl delete node "${staleNode}" || true
  fi
done

# Final guard: this is a single-node install. If more than one node remains
# after stale-node cleanup, a second node genuinely joined the cluster -- abort
# rather than continue with an unexpected topology.
echo "Verifying single-node topology" | log
NODE_COUNT="$(microk8s kubectl get nodes --no-headers 2>/dev/null | wc -l | tr -d ' ')"
echo "Detected ${NODE_COUNT} node(s)" | log
[ "${NODE_COUNT}" -eq 1 ]
waitOrStop 0 "Expected exactly 1 node but found ${NODE_COUNT}"

echo "Applying provider secret to cluster" | log
microk8s kubectl apply -f "$rootDir/guest.yaml"
waitOrStop 0 "Unable to apply provider secret"

echo "Modifying microk8s repository" | log
microk8s addons repo remove core-fork || true

microk8s addons repo add core-fork \
  https://github.com/cloudwm/microk8s-core-addons.git
  waitOrStop 0 "Repository addition failed"

sudo microk8s addons repo remove core
echo "Generating admin-user and login token" | log
cat << EOF > $rootDir/user.yaml
apiVersion: v1
kind: ServiceAccount
metadata:
  name: admin-user
  namespace: kube-system

---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: admin-user
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: cluster-admin
subjects:
- kind: ServiceAccount
  name: admin-user
  namespace: kube-system

---
apiVersion: v1
kind: Secret
metadata:
  name: admin-user
  namespace: kube-system
  annotations:
    kubernetes.io/service-account.name: "admin-user"
type: kubernetes.io/service-account-token
EOF
echo "Applying admin-user yaml to cluster" | log
microk8s kubectl apply -f $rootDir/user.yaml
waitOrStop 0 "Unable to apply admin-user yaml"

echo "Resolving server IP and CWM domain" | log
export CWM_SERVERIP=`hostname -I | awk '{print $1}'`

echo "Cloning dashboard repository" | log
cd $rootDir && git clone https://github.com/cloudwm/k8s-dashboard.git
waitOrStop 0 "Reload haproxy service failed"

echo "Downloading helm dependencies" | log
cd $rootDir/k8s-dashboard/charts/kubernetes-dashboard
microk8s helm repo add ingress-nginx https://kubernetes.github.io/ingress-nginx
microk8s helm repo add jetstack.io https://charts.jetstack.io
microk8s helm repo add kubernetes-sigs https://kubernetes-sigs.github.io/metrics-server/
microk8s helm repo add kong https://charts.konghq.com
microk8s helm dependency build
waitOrStop 0 "dependency build failed"

echo "Patching values.yaml with domain and server IP" | log
# Ingress host (0.0.0.0 -> CWM_DOMAIN) and the in-cluster ingress-nginx public
# address (externalIPs 1.1.1.1 -> CWM_SERVERIP). The controller therefore owns
# CWM_SERVERIP:80 and :443 directly and terminates TLS itself -- no host nginx.
sed -i 's/0.0.0.0/'"$CWM_DOMAIN"'/' values.yaml
sed -i 's/1.1.1.1/'"$CWM_SERVERIP"'/' values.yaml

echo "Selecting ACME (Let's Encrypt) settings" | log
# Email used to register the ACME account (expiry/renewal notices).
ACME_EMAIL="${CWM_EMAIL:-admin@${CWM_DOMAIN}}"
# Default Let's Encrypt environment for the dashboard ingress. Both the staging
# and production ClusterIssuers are always created below; this only selects which
# one the ingress is annotated with.
#   prod    -> trusted certificate (subject to LE rate limits)
#   staging -> untrusted test certificate (no rate limits)
ACME_ENV="${CWM_LETSENCRYPT_ENV:-prod}"
case "${ACME_ENV}" in
  staging) ACME_ISSUER="letsencrypt-staging" ;;
  *)       ACME_ISSUER="letsencrypt-prod" ;;
esac
echo "ACME email: ${ACME_EMAIL} | default issuer: ${ACME_ISSUER}" | log

echo "Writing dashboard helm override values" | log
# - cert-manager.enabled: deploy the bundled cert-manager (the in-cluster
#   "certbot") so certificates are issued AND renewed automatically; no
#   host-level certbot and no /etc/letsencrypt files are needed anymore.
# - app.ingress.issuer.{scope,name}: annotate the dashboard ingress with
#   'cert-manager.io/cluster-issuer: <ACME_ISSUER>' so cert-manager's
#   ingress-shim auto-creates the Certificate + TLS secret for CWM_DOMAIN.
# - useDefaultAnnotations is turned off on purpose: the chart default enables
#   ssl-passthrough, which would stop the controller from terminating TLS with
#   the Let's Encrypt secret. We keep only backend-protocol HTTPS (kong serves
#   TLS to the controller) and ssl-redirect; cert-manager's HTTP-01 solver
#   overrides the redirect on the ACME challenge path automatically.
cat << EOF > $rootDir/dashboard-override.yaml
cert-manager:
  enabled: true
  # cert-manager v1.16 fails if both the deprecated .installCRDs and its
  # replacement .crds.enabled are set. The dashboard chart hardcodes
  # installCRDs: true, so force it off here and use the modern crds.* path.
  installCRDs: false
  crds:
    enabled: true
    keep: true
app:
  ingress:
    tls:
      enabled: true
    issuer:
      scope: cluster
      name: ${ACME_ISSUER}
    useDefaultAnnotations: false
    annotations:
      nginx.ingress.kubernetes.io/backend-protocol: "HTTPS"
      nginx.ingress.kubernetes.io/ssl-redirect: "true"
EOF

echo "Installing dashboard helm chart (in-cluster ingress-nginx + cert-manager)" | log
microk8s helm install dashboard . --namespace kube-system -f "$rootDir/dashboard-override.yaml"
waitOrStop 0 "Dashboard install failed"

echo "Retrieving admin-user token" | log
export ADMINTOKEN=`microk8s kubectl get secret admin-user -n kube-system -o jsonpath="{.data.token}" | base64 -d && echo`

#-------------
# Automatic TLS with the in-cluster ingress-nginx + cert-manager.
#
# The bundled ingress-nginx controller owns CWM_SERVERIP:80 and :443 directly
# (service.externalIPs), so it serves the dashboard on the public IP and answers
# the ACME HTTP-01 challenge on port 80. cert-manager (deployed as a sub-chart)
# watches the dashboard ingress, requests a Let's Encrypt certificate via the
# selected ClusterIssuer, and renews it automatically. There is no host nginx
# and no host-level certbot anymore.
echo "Freeing host ports 80/443 for the in-cluster ingress (disabling host nginx if present)" | log
systemctl disable --now nginx 2>/dev/null || true

echo "Waiting for Kubernetes API before configuring TLS automation" | log
microk8s status --wait-ready
until microk8s kubectl get nodes >/dev/null 2>&1; do
  echo "Waiting for Kubernetes API..." | log
  sleep 5
done

echo "Waiting for internal-nginx IngressClass" | log
until microk8s kubectl get ingressclass internal-nginx >/dev/null 2>&1; do
  echo "Waiting for internal-nginx IngressClass..." | log
  sleep 5
done

echo "Waiting for ingress-nginx controller to become Ready" | log
microk8s kubectl rollout status deployment/dashboard-nginx-controller -n kube-system --timeout=300s

echo "Waiting for cert-manager CRDs to be registered" | log
until microk8s kubectl get crd clusterissuers.cert-manager.io >/dev/null 2>&1; do
  echo "Waiting for clusterissuers.cert-manager.io CRD..." | log
  sleep 5
done

echo "Waiting for cert-manager components to become Available" | log
microk8s kubectl wait --for=condition=Available --timeout=300s \
  -n kube-system deployment \
  -l app.kubernetes.io/instance=dashboard,app.kubernetes.io/name=cert-manager || true
microk8s kubectl wait --for=condition=Available --timeout=300s \
  -n kube-system deployment \
  -l app.kubernetes.io/instance=dashboard,app.kubernetes.io/name=webhook || true

echo "Creating Let's Encrypt ClusterIssuers (staging + production)" | log
cat << EOF > $rootDir/letsencrypt-clusterissuers.yaml
apiVersion: cert-manager.io/v1
kind: ClusterIssuer
metadata:
  name: letsencrypt-staging
spec:
  acme:
    server: https://acme-staging-v02.api.letsencrypt.org/directory
    email: ${ACME_EMAIL}
    privateKeySecretRef:
      name: letsencrypt-staging-account-key
    solvers:
    - http01:
        ingress:
          ingressClassName: internal-nginx
---
apiVersion: cert-manager.io/v1
kind: ClusterIssuer
metadata:
  name: letsencrypt-prod
spec:
  acme:
    server: https://acme-v02.api.letsencrypt.org/directory
    email: ${ACME_EMAIL}
    privateKeySecretRef:
      name: letsencrypt-prod-account-key
    solvers:
    - http01:
        ingress:
          ingressClassName: internal-nginx
EOF

# Apply with retry: the cert-manager webhook can reject requests for a short
# while after the deployment reports Available.
ISSUER_APPLIED=0
for attempt in $(seq 1 30); do
  if microk8s kubectl apply -f "$rootDir/letsencrypt-clusterissuers.yaml"; then
    ISSUER_APPLIED=1
    break
  fi
  echo "cert-manager webhook not ready yet, retrying ClusterIssuer apply (${attempt}/30)..." | log
  sleep 10
done
[ "${ISSUER_APPLIED}" -eq 1 ]
waitOrStop 0 "Failed to apply Let's Encrypt ClusterIssuers"

echo "Waiting for kubernetes-dashboard ingress to exist" | log
until microk8s kubectl get ingress kubernetes-dashboard -n kube-system >/dev/null 2>&1; do
  echo "Waiting for kubernetes-dashboard ingress..." | log
  sleep 5
done

echo "Dashboard ingress (cert-manager requests the certificate automatically):" | log
microk8s kubectl get ingress kubernetes-dashboard -n kube-system -o wide || true

# Best-effort wait for issuance. HTTP-01 needs CWM_DOMAIN to resolve to this
# server and port 80 reachable from the internet; cert-manager keeps retrying on
# its own, so do not fail the whole install if it is not Ready within the window.
echo "Waiting (best-effort) for the dashboard TLS certificate to be issued" | log
if microk8s kubectl wait --for=condition=Ready certificate -n kube-system --all --timeout=300s; then
  echo "Dashboard TLS certificate issued via ${ACME_ISSUER}" | log
else
  echo "Certificate not Ready yet; cert-manager will keep retrying in the background." | log
  echo "Inspect with: microk8s kubectl describe certificate -n kube-system" | log
fi
#------------+

echo "Adding descriptions" | log
descriptionAppend "Kubernetes Dashboard UI: https://${CWM_DOMAIN}/"
descriptionAppend " "
descriptionAppend "TLS is managed automatically in-cluster by cert-manager (issuer: ${ACME_ISSUER})."
descriptionAppend "To switch the environment, re-annotate the ingress, e.g.:"
descriptionAppend "  microk8s kubectl annotate ingress kubernetes-dashboard -n kube-system --overwrite cert-manager.io/cluster-issuer=letsencrypt-prod"
descriptionAppend " "
descriptionAppend "Kubernetest admin-user token: ${ADMINTOKEN}"
descriptionAppend " "

echo "Tagging script as success" | log
tagScript success

echo "Exiting microk8s-1.3x-custom script" | log
exit 0
