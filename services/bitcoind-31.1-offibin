#!/bin/bash

if [ -f "include/startup.sh" ]; then
    . include/startup.sh
elif [ -f "../include/startup.sh" ]; then
    . ../include/startup.sh
fi

# No apt step here prompts today, but an unattended install must never be able to
# open one - a conffile prompt blocks the image build forever.
export DEBIAN_FRONTEND=noninteractive

rootDir=$(rootDir)

bitcoinVersion="31.1"
bitcoinUser="bitcoin"
dataDir="/var/lib/bitcoind"
confDir="/etc/bitcoin"
confFile="${confDir}/bitcoin.conf"
baseUrl="https://bitcoincore.org/bin/bitcoin-core-${bitcoinVersion}"

# Pruning only discards block files - the UTXO chainstate is never pruned, and at
# ~11GB (about 170M UTXOs, mid-2026) growing 2-3GB a year it is the real storage
# floor. reserveMb covers it plus roughly three years of that growth; minFreeMb
# leaves ~10GB of block data on top. Refuse to build a node that cannot finish
# its initial sync instead of one that fills the disk months later.
minFreeMb=30720
reserveMb=20480
# Block data measured 764GB at height 963,967 (Aug 2026); go archival only with
# room for it plus the txindex.
archivalMb=921600

echo "Installing dependencies" | log
# openssl is only priority:optional on Ubuntu and arrives as someone else's
# dependency, so ask for it explicitly rather than trusting it to be there - the
# RPC password below is generated with it.
installPackage ca-certificates curl openssl
waitOrStop 0 "Failed apt install: ca-certificates curl openssl"

# Sized before anything is downloaded or installed: a box that cannot hold the
# chain should fail here, not after an 86MB download and a half-installed node.
echo "Sizing block storage against available disk" | log
mkdir -p ${dataDir}
availMb=$(df -Pm ${dataDir} | awk 'NR==2{print $4}')
if ! [[ "${availMb}" =~ ^[0-9]+$ ]]; then
	echo "Could not read free space for ${dataDir}. exiting (1)." | log 1
	exit 1
fi
if [ "${availMb}" -lt "${minFreeMb}" ]; then
	echo "Only ${availMb}MB free on ${dataDir}; Bitcoin Core needs at least ${minFreeMb}MB even when pruned (the UTXO chainstate alone is ~11GB and is never pruned). exiting (1)." | log 1
	exit 1
fi
budgetMb=$((availMb - reserveMb))
if [ "${budgetMb}" -ge "${archivalMb}" ]; then
	# Room for the whole chain: keep every block and build the tx index.
	pruneSetting="prune=0"
	indexSetting="txindex=1"
	nodeMode="archival (full history, txindex enabled)"
else
	pruneSetting="prune=${budgetMb}"
	indexSetting="txindex=0"
	nodeMode="pruned to ${budgetMb}MB of block data"
fi
echo "Node mode: ${nodeMode}" | log

case "$(uname -m)" in
x86_64) bitcoinArch="x86_64-linux-gnu" ;;
aarch64 | arm64) bitcoinArch="aarch64-linux-gnu" ;;
*)
	echo "Unsupported architecture: $(uname -m). exiting (1)." | log 1
	exit 1
	;;
esac
tarBall="bitcoin-${bitcoinVersion}-${bitcoinArch}.tar.gz"

echo "Downloading Bitcoin Core ${bitcoinVersion} (${bitcoinArch})" | log
cd $rootDir/temp || exit 1
rm -f ${tarBall} SHA256SUMS
curlDownload ${baseUrl}/${tarBall}
curlDownload ${baseUrl}/SHA256SUMS

# The published archive is only usable if it arrived whole. A truncated download
# extracts into binaries that segfault at run time rather than failing here, so
# verify before touching anything outside temp.
echo "Verifying SHA256 checksum" | log
checksumOutput=$(sha256sum --ignore-missing --check SHA256SUMS 2>&1)
waitOrStop 0 "SHA256 checksum verification failed for ${tarBall}"
echo "${checksumOutput}" | log

echo "Extracting Bitcoin Core" | log
rm -rf bitcoin-${bitcoinVersion}
tar -xzf ${tarBall}
waitOrStop 0 "Failed to extract ${tarBall}"

echo "Installing binaries to /usr/local/bin" | log
# Named explicitly rather than bin/*: the tarball also ships bitcoin-qt, 43MB of
# Qt GUI that no headless image can use.
for binary in bitcoin bitcoind bitcoin-cli bitcoin-tx bitcoin-util bitcoin-wallet; do
	install -m 0755 bitcoin-${bitcoinVersion}/bin/${binary} /usr/local/bin/
	waitOrStop 0 "Failed to install ${binary}"
done

# Run bitcoind on its own here: piping it into head would hand waitOrStop head's
# exit status, so a binary that segfaults would still look like a clean install.
versionOutput=$(/usr/local/bin/bitcoind --version)
waitOrStop 0 "Installed bitcoind does not run"
installedVersion=$(echo "${versionOutput}" | head -n1)
echo "Installed: ${installedVersion}" | log

echo "Creating ${bitcoinUser} system user" | log
# No --create-home: the sizing step above already made ${dataDir}, and useradd
# only warns and skips when the home directory exists. It is chowned below.
id -u ${bitcoinUser} >/dev/null 2>&1 || useradd --system --home ${dataDir} --shell /usr/sbin/nologin ${bitcoinUser}
waitOrStop 0 "Failed to create ${bitcoinUser} user"

echo "Writing ${confFile}" | log
mkdir -p ${confDir}
# rpcauth rather than rpcuser/rpcpassword: Core logs "The use of rpcuser/
# rpcpassword is less secure, because credentials are configured in plain text"
# and recommends hashed credentials. Only the salted HMAC reaches the config
# file; the password itself goes to the description the operator reads.
rpcUser="bitcoinrpc"
rpcPassword=$(openssl rand -hex 24)
rpcSalt=$(openssl rand -hex 16)
rpcHmac=$(printf '%s' "${rpcPassword}" | openssl dgst -sha256 -hmac "${rpcSalt}" -r | cut -d' ' -f1)
# Empty values here would write a credential line that authenticates nothing, so
# refuse rather than generate that file.
if [ -z "${rpcPassword}" ] || [ -z "${rpcSalt}" ] || [ -z "${rpcHmac}" ]; then
	echo "Failed to generate RPC credentials. exiting (1)." | log 1
	exit 1
fi

# dbcache is the UTXO cache held in RAM. A quarter of the box, capped at 2GB, is
# the preference - but Bitcoin Core logs "A %d MiB dbcache may be too large for a
# system memory of only %d MiB" above its own limit, which src/node/caches.h puts
# at max(450 MiB, 75% of RAM above a reserved 2GiB). Mirror that so small plans
# never boot with a warning: on a 2GB box the quarter-share would be 492 MiB and
# the cap is 450 MiB.
ramMb=$(awk '/MemTotal/{print int($2/1024)}' /proc/meminfo)
kernelDefaultMb=450
reservedRamMb=2048
if [ "${ramMb}" -gt "${reservedRamMb}" ]; then
	availRamMb=$((ramMb - reservedRamMb))
else
	availRamMb=0
fi
coreCapMb=$((availRamMb * 3 / 4))
[ "${coreCapMb}" -lt "${kernelDefaultMb}" ] && coreCapMb=${kernelDefaultMb}

dbCacheMb=$((ramMb / 4))
[ "${dbCacheMb}" -gt 2048 ] && dbCacheMb=2048
[ "${dbCacheMb}" -gt "${coreCapMb}" ] && dbCacheMb=${coreCapMb}
[ "${dbCacheMb}" -lt 128 ] && dbCacheMb=128
cat <<EOF >${confFile}
# Bitcoin Core ${bitcoinVersion} - generated by the installer
server=1
daemon=0
datadir=${dataDir}

# Accept inbound peers on the default p2p port
listen=1

# RPC is reachable from this host only. Anything remote should go through a
# proxy that terminates TLS - Bitcoin Core speaks plain HTTP on this socket.
rpcbind=127.0.0.1
rpcallowip=127.0.0.1
rpcauth=${rpcUser}:${rpcSalt}\$${rpcHmac}

${pruneSetting}
${indexSetting}
dbcache=${dbCacheMb}
EOF

chown -R ${bitcoinUser}:${bitcoinUser} ${dataDir}
chown -R root:${bitcoinUser} ${confDir}
chmod 750 ${confDir}
chmod 640 ${confFile}

echo "Opening p2p port 8333" | log
ufw allow 8333 | log

echo "Adding Systemd Service" | log
cat <<EOF >/etc/systemd/system/bitcoind.service
[Unit]
Description=Bitcoin Core daemon
After=network-online.target
Wants=network-online.target

[Service]
User=${bitcoinUser}
Group=${bitcoinUser}
Type=simple
ExecStart=/usr/local/bin/bitcoind -conf=${confFile} -datadir=${dataDir} -printtoconsole
Restart=on-failure
RestartSec=10
# Shutting down mid-write corrupts the block database, so give it room to flush.
TimeoutStopSec=600
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
NoNewPrivileges=true
ReadWritePaths=${dataDir}

[Install]
WantedBy=multi-user.target
EOF
systemctl daemon-reload
waitOrStop 0 "daemon-reload failed"

echo "Starting bitcoind service" | log
systemctl enable bitcoind.service
systemctl start bitcoind.service
waitOrStop 0 "bitcoind service did not start"

# bitcoind binds its RPC socket only after the block index is loaded, and answers
# every call with an error until then. Poll rather than sleep so a daemon that
# dies on a bad config is reported here instead of looking like a clean install.
# 300s, not 150s: on a fresh datadir this answers in seconds, but a re-run over an
# existing chain has to load the block index first, which takes minutes.
echo "Waiting for RPC to answer" | log
rpcOk=0
for _ in $(seq 1 60); do
	if bitcoin-cli -conf=${confFile} -datadir=${dataDir} getblockchaininfo >/dev/null 2>&1; then
		rpcOk=1
		break
	fi
	sleep 5
done
if [ ${rpcOk} -ne 1 ]; then
	echo "bitcoind RPC did not respond within 300s" | log 1
	journalctl -u bitcoind --no-pager -n 30 2>&1 | log 1
	exit 1
fi
echo "RPC is answering" | log

# A node that reaches no peers never syncs, and nothing above would notice: the
# service is up and the RPC answers. Deliberately a warning and not a hard exit,
# so an install into a network that blocks 8333 on purpose still completes -
# swap the warning for "exit 1" if a node that cannot sync should fail the build.
echo "Checking peer connectivity" | log
peerCount=0
for _ in $(seq 1 12); do
	peerCount=$(bitcoin-cli -conf=${confFile} -datadir=${dataDir} getconnectioncount 2>/dev/null)
	[[ "${peerCount}" =~ ^[0-9]+$ ]] || peerCount=0
	[ "${peerCount}" -gt 0 ] && break
	sleep 10
done
if [ "${peerCount}" -gt 0 ]; then
	echo "Connected to ${peerCount} peers" | log
	peerStatus="connected to ${peerCount} peers at install time"
else
	echo "WARNING: no peers after 120s. Outbound TCP 8333 is most likely blocked upstream - this node cannot sync until it is opened." | log 1
	peerStatus="NO PEERS at install time - check that outbound TCP 8333 is open"
fi

echo "Adding descriptions" | log
descriptionAppend "Bitcoin Core: ${installedVersion}"
descriptionAppend "Bitcoin node mode: ${nodeMode}"
descriptionAppend "Bitcoin data directory: ${dataDir}"
descriptionAppend "Bitcoin config file: ${confFile}"
descriptionAppend "Bitcoin RPC username: ${rpcUser}"
descriptionAppend "Bitcoin RPC password: ${rpcPassword}"
descriptionAppend "Bitcoin RPC endpoint: http://127.0.0.1:8332 (localhost only)"
descriptionAppend "Bitcoin p2p status: ${peerStatus}"
descriptionAppend " "
descriptionAppend "Check sync status:"
descriptionAppend "  bitcoin-cli -conf=${confFile} -datadir=${dataDir} getblockchaininfo"
descriptionAppend "Follow the log:"
descriptionAppend "  journalctl -u bitcoind -f"
descriptionAppend " "

tagScript success

exit 0
