=======
# Combine fullchain + private key into the single PEM HAProxy expects, directly in
# the live cert dir. This mirrors the manual fix that worked on the server. Use the
# live symlinks fullchain.pem/privkey.pem (they always point at the current cert)
# instead of globbing the archive, which would concatenate every past
# *fullchain*/*privk* version and produce a broken PEM.
cd ${certsPath}
waitOrStop 0 "Certificate directory ${certsPath} not found"
cat fullchain.pem privkey.pem > ${certGeneratedName}
waitOrStop 0 "Failed to build ${certGeneratedName}"
echo "Freeing port 80 for HAProxy (disabling nginx if present)" | log
# nginx is pulled in by the Let's Encrypt step and left enabled, so it auto-starts
# on boot (e.g. after the kernel upgrade mid-install) and holds :80, making HAProxy
# fail with "cannot bind socket (Address already in use)". HAProxy is the front LB
# here, so take :80 from nginx for good.
systemctl disable --now nginx 2>/dev/null || true
