#!/bin/bash

if [ -f "include/startup.sh" ]; then
    . include/startup.sh
elif [ -f "../include/startup.sh" ]; then
    . ../include/startup.sh
fi

rootDir=$(rootDir)
# Auto-detect the Let's Encrypt live cert directory created by the earlier
# nginx-letsencrypt-cert step, by locating the dir that holds fullchain.pem. This
# makes HAProxy find the cert regardless of how that step named the dir (domain vs
# IP) — self-contained, with no dependency on or changes to the cert-producing file.
certsPath=$(dirname "$(find /etc/letsencrypt/live -name fullchain.pem 2>/dev/null | head -n1)")
[[ -z "${certsPath}" || "${certsPath}" == "." ]] && certsPath="/etc/letsencrypt/live/${CWM_DOMAIN}"
certsUpdateService=/opt/update-certs.sh
certGeneratedName="haproxy-fullcert.pem"
echo "Installing dependencies" | log
installPackage software-properties-common
waitOrStop 0 "Failed apt install: software-properties-common"
ubuntu_version=$(lsb_release -rs)
echo "Adding repository to OS package manager" | log
add-apt-repository ppa:vbernat/haproxy-3.3 -y
apt update
echo "Installing main application" | log
installPackage haproxy=3.3.\* | log
waitOrStop 0 "Failed apt install: haproxy 3.3.*"
echo "Open port for stats web ui" | log
ufw allow 8404
echo "Placing annotated config file" | log
backupFile /etc/haproxy/haproxy.cfg
cp -f $rootDir/tweaks/extras/haproxy/haproxy.cfg /etc/haproxy/haproxy.cfg
pass=$(echo ${ADMINPASSWORD//\&/\\&} | sed 's|[$#]|\\\\&|g')
sed -i '/stats auth/s/USERPASS_PLACEHOLDER/admin:"'$pass'"/g' /etc/haproxy/haproxy.cfg
sed -i 's|CERTS_PATH_PLACEHOLDER|'"${certsPath}"'|g' /etc/haproxy/haproxy.cfg
sed -i 's/CERT_GENERATED_NAME/'"${certGeneratedName}"'/g' /etc/haproxy/haproxy.cfg
echo "Generating proper haproxy certificate" | log
# Combine fullchain + private key into the single PEM HAProxy expects, directly in
# the live cert dir. This mirrors the manual fix that worked on the server. Use the
# live symlinks fullchain.pem/privkey.pem (they always point at the current cert)
# instead of globbing the archive, which would concatenate every past
# *fullchain*/*privk* version and produce a broken PEM.
cd ${certsPath}
waitOrStop 0 "Certificate directory ${certsPath} not found"
cat fullchain.pem privkey.pem > ${certGeneratedName}
waitOrStop 0 "Failed to build ${certGeneratedName}"
echo "Freeing port 80 for HAProxy (disabling nginx if present)" | log
# nginx is pulled in by the Let's Encrypt step and left enabled, so it auto-starts
# on boot (e.g. after the kernel upgrade mid-install) and holds :80, making HAProxy
# fail with "cannot bind socket (Address already in use)". HAProxy is the front LB
# here, so take :80 from nginx for good.
systemctl disable --now nginx 2>/dev/null || true
service haproxy reload
waitOrStop 0 "Reload haproxy service failed"
# This script runs as certbot's own --post-hook (see the sed below), so it must NOT
# invoke "certbot renew" itself: the outer certbot still holds
# /var/lib/letsencrypt/.certbot.lock and the nested call dies with "Another
# instance of Certbot is already running". It only has to rebuild the combined PEM
# from the certificate certbot just renewed and reload HAProxy.
cat << EOF > ${certsUpdateService}
#!/bin/bash
cd ${certsPath} || exit 1
cat fullchain.pem privkey.pem > ${certGeneratedName}
service haproxy reload
EOF
chmod +x ${certsUpdateService}

backupFile /lib/systemd/system/certbot.service
# sed -i '\|ExecStart|s|=.*|=/bin/bash '"${certsUpdateService}"'|' /lib/systemd/system/certbot.service
sed -i '\|ExecStart|s|-q renew|-q renew --post-hook "/bin/bash '${certsUpdateService}'"|' /lib/systemd/system/certbot.service
systemctl daemon-reload
service haproxy reload
waitOrStop 0 "Reload haproxy service failed"
echo "Downloading DataPlane API from Git" | log
cd $rootDir/temp
curlDownload https://github.com/haproxytech/dataplaneapi/releases/download/v2.3.3/dataplaneapi_2.3.3_Linux_x86_64.tar.gz
waitOrStop 0 "File not downloaded from official source"
echo "Extracting DataPlane & Setting Permissions" | log
cd $rootDir/temp
tar -xzvf dataplaneapi_2.3.3_Linux_x86_64.tar.gz
chmod +x build/dataplaneapi
cp build/dataplaneapi /usr/local/bin/
echo "Creating DataPlane Config File" | log
cp -f $rootDir/tweaks/extras/haproxy/dataplaneapi.hcl /etc/haproxy/
cat /root/guest.conf | grep api >> /etc/default/haproxy
sed -i "s/apiClientId/clientID/g" /etc/default/haproxy
sed -i "s/apiSecret/secret/g" /etc/default/haproxy

echo "Registering DataPlane API as a systemd service" | log
# HAProxy 3.3 removed the "program" section, so the binary can no longer be launched
# from haproxy.cfg the way earlier versions did ("unknown keyword 'program'" -> fatal
# config error). Run it as its own unit instead, tied to haproxy so it follows the
# load balancer's lifecycle.
cat << 'EOF' > /etc/systemd/system/dataplaneapi.service
[Unit]
Description=HAProxy Data Plane API
After=network-online.target haproxy.service
Wants=network-online.target
PartOf=haproxy.service

[Service]
Type=simple
EnvironmentFile=-/etc/default/haproxy
ExecStart=/usr/local/bin/dataplaneapi -f /etc/haproxy/dataplaneapi.hcl
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF
systemctl daemon-reload
systemctl enable --now dataplaneapi
waitOrStop 0 "Failed to start dataplaneapi service"

systemctl reload haproxy
waitOrStop 0 "Failed to reload HAProxy" | log
echo "Adding descriptions" | log
descriptionAppend "HAProxy Address: ${CWM_DOMAIN}"
descriptionAppend " "
descriptionAppend "HAProxy Stats Web UI: https://${CWM_DOMAIN}:8404/stats"
descriptionAppend "HAProxy Stats Web UI Username: admin"
descriptionAppend "HAProxy Stats Web UI Password: ${ADMINPASSWORD}"
descriptionAppend " "
descriptionAppend "HAProxy config file: /etc/haproxy/haproxy.cfg"
descriptionAppend " "
descriptionAppend "HAProxy examples: /usr/share/doc/haproxy/examples"
descriptionAppend "HAProxy documentation (on-server): /usr/share/doc/haproxy/"
descriptionAppend "HAProxy documentation (online): https://docs.haproxy.org/3.3/intro.html"
descriptionAppend " "
tagScript success
exit 0
