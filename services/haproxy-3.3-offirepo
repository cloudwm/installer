# Auto-detect the Let's Encrypt live cert directory created by the earlier
# nginx-letsencrypt-cert step, by locating the dir that holds fullchain.pem. This
# makes HAProxy find the cert regardless of how that step named the dir (domain vs
# IP) — self-contained, with no dependency on or changes to the cert-producing file.
certsPath=$(dirname "$(find /etc/letsencrypt/live -name fullchain.pem 2>/dev/null | head -n1)")
[[ -z "${certsPath}" || "${certsPath}" == "." ]] && certsPath="/etc/letsencrypt/live/${CWM_DOMAIN}"
