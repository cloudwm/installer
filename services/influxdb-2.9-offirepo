#!/bin/bash

if [ -f "include/startup.sh" ]; then
    . include/startup.sh
elif [ -f "../include/startup.sh" ]; then
    . ../include/startup.sh
fi

checkTagExist ssl-ready.success

rootDir=$(rootDir)

certsPath=/etc/letsencrypt/live/${CWM_DOMAIN}
influxConfDir=/etc/influxdb
influxConfFile=${influxConfDir}/config.toml
influxCert=${influxConfDir}/cert.pem
influxKey=${influxConfDir}/key.pem
certsUpdateService=/opt/update-influxdb-certs.sh
influxPort=8086

# Published on docs.influxdata.com; pinned so a swapped key on the mirror fails
# the install instead of silently signing packages we would then trust.
influxKeyFingerprint="24C975CBA61A024EE1B631787C3D57159FC2F927"

echo "Installing dependencies" | log
installPackage ca-certificates curl gnupg
waitOrStop 0 "Failed apt install: ca-certificates curl gnupg"

echo "Adding InfluxData signing key" | log
cd $rootDir/temp
rm -f influxdata-archive.key
curlDownload https://repos.influxdata.com/influxdata-archive.key
waitOrStop 0 "Key not downloaded from official source"

downloadedFingerprint=$(gpg --show-keys --with-fingerprint --with-colons influxdata-archive.key 2>/dev/null | awk -F: '/^fpr:/{print $10; exit}')
if [ "${downloadedFingerprint}" != "${influxKeyFingerprint}" ]; then
	echo "InfluxData key fingerprint mismatch: got '${downloadedFingerprint}', expected '${influxKeyFingerprint}'. exiting (1)." | log 1
	exit 1
fi
echo "Key fingerprint verified: ${downloadedFingerprint}" | log

mkdir -p /etc/apt/keyrings
gpg --dearmor <influxdata-archive.key >/etc/apt/keyrings/influxdata-archive.gpg
waitOrStop 0 "Failed to write InfluxData keyring"

echo "Adding official InfluxData repository" | log
# signed-by rather than apt-key: apt-key is deprecated and scopes the key to
# every repository on the box instead of just this one.
echo "deb [signed-by=/etc/apt/keyrings/influxdata-archive.gpg] https://repos.influxdata.com/debian stable main" >/etc/apt/sources.list.d/influxdata.list
apt update

echo "Installing main application" | log
installPackage influxdb2=2.9.\* influxdb2-cli
waitOrStop 0 "Failed apt install: influxdb2 2.9.*"

influxdVersion=$(influxd version)
waitOrStop 0 "Installed influxd does not run"
echo "Installed: ${influxdVersion}" | log

echo "Publishing TLS certificate for InfluxDB" | log
# influxd runs as the unprivileged influxdb user and cannot read the 0600 key in
# the letsencrypt live dir, so keep an owned copy beside the config. The renewal
# hook below refreshes it.
mkdir -p ${influxConfDir}
install -o influxdb -g influxdb -m 0644 ${certsPath}/fullchain.pem ${influxCert}
waitOrStop 0 "Certificate not found at ${certsPath}/fullchain.pem"
install -o influxdb -g influxdb -m 0600 ${certsPath}/privkey.pem ${influxKey}
waitOrStop 0 "Private key not found at ${certsPath}/privkey.pem"

echo "Writing ${influxConfFile}" | log
# influxd-systemd-start.sh switches its readiness probe to https as soon as both
# tls-cert and tls-key are set, so setting them here is all that is needed to
# serve the API and UI over TLS.
cat <<EOF >${influxConfFile}
# InfluxDB 2 - generated by the installer
http-bind-address = ":${influxPort}"
tls-cert = "${influxCert}"
tls-key = "${influxKey}"
bolt-path = "/var/lib/influxdb/influxd.bolt"
engine-path = "/var/lib/influxdb/engine"
EOF
chown root:influxdb ${influxConfFile}
chmod 640 ${influxConfFile}

echo "Opening port ${influxPort}" | log
ufw allow ${influxPort} | log

echo "Starting and enabling InfluxDB service" | log
systemctl daemon-reload
systemctl enable influxdb
systemctl restart influxdb
waitOrStop 0 "Failed to start InfluxDB service"

# The unit is Type=forking and its start script blocks until /ready answers, but
# poll anyway so a TLS or config error surfaces here instead of at first use.
echo "Waiting for the InfluxDB API to answer" | log
apiOk=0
for i in $(seq 1 30); do
	code=$(curl -k -s -o /dev/null -w '%{http_code}' https://127.0.0.1:${influxPort}/health 2>/dev/null)
	if [[ "${code}" =~ ^(200|401)$ ]]; then
		apiOk=1
		break
	fi
	sleep 5
done
if [ ${apiOk} -ne 1 ]; then
	echo "InfluxDB API not answering on ${influxPort} (last code: ${code:-none})" | log 1
	journalctl -u influxdb --no-pager -n 30 2>&1 | log 1
	exit 1
fi
echo "InfluxDB API is answering over TLS" | log

echo "Running initial InfluxDB setup" | log
influxUsername="admin"
influxOrg="main"
influxBucket="default"
influxPassword=$(openssl rand -hex 16)
influxToken=$(openssl rand -hex 32)

# --skip-verify: the certificate is issued for ${CWM_DOMAIN} and this call goes to
# the loopback address, so hostname verification cannot match. Local hop only.
influx setup --force --skip-verify --host https://127.0.0.1:${influxPort} --org ${influxOrg} --bucket ${influxBucket} --username ${influxUsername} --password ${influxPassword} --token ${influxToken} --retention 0
waitOrStop 0 "InfluxDB initial setup failed"

echo "Registering certificate renewal hook" | log
cat <<EOF >${certsUpdateService}
#!/bin/bash
# Refresh the copies influxd reads after certbot renews the certificate.
install -o influxdb -g influxdb -m 0644 ${certsPath}/fullchain.pem ${influxCert}
install -o influxdb -g influxdb -m 0600 ${certsPath}/privkey.pem ${influxKey}
systemctl restart influxdb
EOF
chmod +x ${certsUpdateService}

# Without this hook influxd keeps serving the copies made above and the
# certificate silently expires 90 days later, so a missing unit is a hard error
# rather than something to skip quietly.
if [ ! -f /lib/systemd/system/certbot.service ]; then
	echo "certbot.service not found - cannot register the renewal hook. exiting (1)." | log 1
	exit 1
fi
backupFile /lib/systemd/system/certbot.service
sed -i '\|ExecStart|s|-q renew|-q renew --post-hook "/bin/bash '${certsUpdateService}'"|' /lib/systemd/system/certbot.service
grep -q "${certsUpdateService}" /lib/systemd/system/certbot.service
waitOrStop 0 "Failed to register the certificate renewal hook in certbot.service"
systemctl daemon-reload

echo "Adding descriptions" | log
descriptionAppend "InfluxDB Web UI: https://${CWM_DOMAIN}:${influxPort}"
descriptionAppend "InfluxDB Username: ${influxUsername}"
descriptionAppend "InfluxDB Password: ${influxPassword}"
descriptionAppend "InfluxDB Admin Token: ${influxToken}"
descriptionAppend "InfluxDB Organization: ${influxOrg}"
descriptionAppend "InfluxDB Initial Bucket: ${influxBucket}"
descriptionAppend " "
descriptionAppend "InfluxDB config file: ${influxConfFile}"
descriptionAppend "InfluxDB data directory: /var/lib/influxdb"
descriptionAppend " "

tagScript success

exit 0
