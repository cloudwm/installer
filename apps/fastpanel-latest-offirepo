#!/bin/bash

if [ -f "include/startup.sh" ]; then
    . include/startup.sh
elif [ -f "../include/startup.sh" ]; then
    . ../include/startup.sh
else
    echo "Error: startup.sh not found in include/ or ../include/" >&2
    exit 1
fi

echo "Downloading and installing FastPanel" | log
installPackage ca-certificates wget
LOG_FILE="/tmp/fastpanel_install.log"
wget https://repo.fastpanel.direct/install_fastpanel.sh -O - | bash - 2>&1 | tee "$LOG_FILE"
waitOrStop 0 "Failed to install FastPanel"

ufw allow 8888
ufw allow 7777
ufw reload

FASTPASSWORD=$(grep -oP "Password:\s*\K.*" "$LOG_FILE")
rm -f $LOG_FILE

PANEL_URL_HOST="${CWM_DISPLAYED_ADDRESS}"
if [ -n "${CWM_DOMAIN}" ] && [[ "${CWM_DOMAIN}" == *.* ]]; then
    echo "Registering FastPanel address ${CWM_DOMAIN}" | log
    /usr/local/fastpanel2/fastpanel panel add --server-name="${CWM_DOMAIN}" 2>&1 | log

    LE_OK=0
    for attempt in 1 2 3; do
        echo "Issuing Let's Encrypt cert for ${CWM_DOMAIN} (attempt ${attempt}/3)" | log
        if /usr/local/fastpanel2/fastpanel panel change-certificate \
                --server-name="${CWM_DOMAIN}" \
                --certificate-type=letsencrypt 2>&1 | log; then
            LE_OK=1
            break
        fi
        sleep 20
    done
    if [ "${LE_OK}" = "1" ]; then
        export CWM_DISPLAYED_ADDRESS="${CWM_DOMAIN}"
        tag global-domain-set.success
        PANEL_URL_HOST="${CWM_DOMAIN}"
    else
        echo "FastPanel LE cert issuance failed after 3 attempts; panel still works on self-signed cert and can be reissued from the UI" | log 1
    fi
fi

descriptionAppend "FastPanel Web UI: https://${PANEL_URL_HOST}:8888"
descriptionAppend "FastPanel Web User: fastuser"
descriptionAppend "FastPanel Web Password: ${FASTPASSWORD}"

exit 0
