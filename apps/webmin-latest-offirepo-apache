#!/bin/bash

if [ -f "include/startup.sh" ]; then
    . include/startup.sh
elif [ -f "../include/startup.sh" ]; then
    . ../include/startup.sh
fi

echo "Installing Packages" | log
curl -o webmin-setup-repo.sh https://raw.githubusercontent.com/webmin/webmin/master/webmin-setup-repo.sh
sh webmin-setup-repo.sh -f
waitOrStop 0 "Failed to setup Webmin repository"

echo "Installing Webmin App" | log
apt-get install -y webmin --install-recommends
waitOrStop 0 "Failed apt install Webmin"

# Webmin keeps its default all-interface bind on 10000 (self-signed SSL) so it stays
# directly reachable as a fallback. Secured public access is via the Apache SSL proxy on 443.
# Trust two referers: Apache forwards Host: localhost:10000 (no ProxyPreserveHost), and direct
# hits land on ${CWM_DOMAIN}:10000 — neither should trip Webmin's referer check.
echo "Configuring Webmin trusted referers" | log
sed -i '/^referer=/d' /etc/webmin/config
echo "referer=localhost ${CWM_DOMAIN}" >> /etc/webmin/config
systemctl restart webmin

echo "Configuring Apache SSL reverse proxy" | log
LE_DIR="/etc/letsencrypt/live/${CWM_DOMAIN}"
a2enmod proxy proxy_http ssl

cat > /etc/apache2/sites-available/webmin.conf <<EOF
<VirtualHost *:80>
    ServerName ${CWM_DOMAIN}
    Redirect permanent / https://${CWM_DOMAIN}/
</VirtualHost>

<VirtualHost *:443>
    ServerName ${CWM_DOMAIN}

    SSLEngine on
    SSLProxyEngine on
    SSLProxyVerify none
    SSLProxyCheckPeerName off
    SSLProxyCheckPeerCN off
    SSLCertificateFile ${LE_DIR}/fullchain.pem
    SSLCertificateKeyFile ${LE_DIR}/privkey.pem

    ProxyPass / https://localhost:10000/
    ProxyPassReverse / https://localhost:10000/
</VirtualHost>
EOF

a2dissite 000-default.conf 2>/dev/null
a2ensite webmin.conf
apache2ctl configtest && systemctl restart apache2
waitOrStop 0 "Failed to start Apache reverse proxy"

echo "Verifying Webmin is reachable through the Apache SSL proxy" | log

# Apache must be up to serve the proxy on 443.
if ! systemctl is-active --quiet apache2; then
    echo "Apache is not active after restart — Webmin UI is not reachable" | log 1
    exit 1
fi

# A trusted public cert is expected; a self-signed fallback is functional but not "secured",
# so warn (don't abort — the cert tweak intentionally falls back on transient LE outages).
if ! [ -f "${LE_DIR}/fullchain.pem" ]; then
    echo "No certificate found at ${LE_DIR}/fullchain.pem" | log 1
    exit 1
fi
if openssl x509 -in "${LE_DIR}/fullchain.pem" -noout -issuer 2>/dev/null | grep -qi "Self-Signed"; then
    echo "WARNING: serving a self-signed certificate for ${CWM_DOMAIN} (Let's Encrypt fell back)" | log 1
fi

# Wait for Webmin's miniserv to actually be listening on 10000 before proxying to
# it. A fresh `systemctl restart webmin` takes several seconds to bind, and the
# check below otherwise races it — Apache can't reach the backend and returns 503.
for i in $(seq 1 30); do
    curl -sk -o /dev/null -m 5 https://localhost:10000/ && break
    sleep 2
done

# End-to-end: the proxy must actually serve Webmin's login over 443 for this vhost.
# Retry a few times so a slow-to-warm backend doesn't fail the whole install.
code=000
for attempt in 1 2 3 4 5; do
    code=$(curl -sk -o /dev/null -w '%{http_code}' -m 10 -H "Host: ${CWM_DOMAIN}" https://localhost/)
    case "$code" in 200|302|401) break ;; esac
    echo "Webmin proxy not ready (HTTP $code), attempt ${attempt}/5; retrying in 5s" | log
    sleep 5
done
case "$code" in
    200|302|401) echo "Webmin proxy reachable on https://${CWM_DOMAIN}/ (HTTP $code)" | log ;;
    *) echo "Webmin proxy check failed on https://${CWM_DOMAIN}/ (HTTP $code)" | log 1; exit 1 ;;
esac

echo "Adding descriptions" | log
descriptionAppend "Webmin Username: root"
descriptionAppend "Webmin Password: ${ADMINPASSWORD}"
descriptionAppend "Webmin UI: https://${CWM_DOMAIN}"
descriptionAppend "Webmin UI (direct, self-signed): https://${CWM_DOMAIN}:10000"
descriptionAppend " "
descriptionAppend "Webmin app location: /etc/webmin/"
descriptionAppend "Webmin mini-server configuration: /etc/webmin/miniserv.conf"
descriptionAppend "Webmin-Apache proxy configuration: /etc/apache2/sites-available/webmin.conf"
descriptionAppend " "

tagScript success

exit 0
