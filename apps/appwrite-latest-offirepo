#!/bin/bash

if [ -f "include/startup.sh" ]; then
    . include/startup.sh
elif [ -f "../include/startup.sh" ]; then
    . ../include/startup.sh
fi

if [ -z "$CWM_DOMAIN" ]; then
    echo "Error: CWM_DOMAIN is empty. Appwrite requires a real hostname for the platform domain check; without it the Console returns 401 (general_access_forbidden)." | log 1
    exit 1
fi

echo "Installing Docker and Docker Compose" | log
export DEBIAN_FRONTEND="noninteractive"

# Update system packages
sudo apt update
sudo apt install -y apt-transport-https ca-certificates curl gnupg lsb-release

# Add Docker's official GPG key and repository
curl -fsSL https://download.docker.com/linux/ubuntu/gpg | sudo gpg --dearmor -o /usr/share/keyrings/docker-archive-keyring.gpg
echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/docker-archive-keyring.gpg] https://download.docker.com/linux/ubuntu $(lsb_release -cs) stable" | sudo tee /etc/apt/sources.list.d/docker.list > /dev/null

# Install Docker and Docker Compose
sudo apt update
sudo apt install -y docker-ce docker-ce-cli containerd.io docker-compose-plugin

# Add current user to docker group
sudo usermod -aG docker $USER

sleep 5

APPWRITE_VERSION="1.9.0"

echo "Setting up Appwrite installation directory" | log
mkdir -p /opt/appwrite
cd /opt/appwrite

APPWRITE_SECRET=$(openssl rand -hex 32)

echo "Generating Appwrite configuration via official installer (v${APPWRITE_VERSION})" | log
docker run --rm \
    --volume /var/run/docker.sock:/var/run/docker.sock \
    --volume /opt/appwrite/appwrite:/usr/src/code/appwrite:rw \
    --entrypoint=install \
    -e _APP_DOMAIN="${CWM_DOMAIN}" \
    -e _APP_DOMAIN_TARGET="${CWM_DOMAIN}" \
    -e _APP_SYSTEM_SECURITY_MASTER_KEY="${APPWRITE_SECRET}" \
    appwrite/appwrite:${APPWRITE_VERSION} \
    --interactive=N --http-port=80 --https-port=443 --no-start 2>&1 | log
waitOrStop 0 "Appwrite installer failed to generate compose/.env"

cd /opt/appwrite/appwrite
if [ ! -f .env ]; then
    echo "Error: .env not generated by installer" | log 1
    exit 1
fi

# The platform-hostname allowlist in app/config/platform.php is built from
# _APP_DOMAIN and _APP_CONSOLE_DOMAIN. Defaults are "localhost", so any other
# Host header is rejected with HTTP 401 general_access_forbidden ("Router
# protection does not allow accessing Appwrite over this domain"). The
# installer container's -e _APP_DOMAIN sets _APP_DOMAIN but not
# _APP_CONSOLE_DOMAIN, so we set both here from CWM_DOMAIN.
echo "Setting platform hostnames to ${CWM_DOMAIN}" | log
sed -i "s|^_APP_DOMAIN=.*|_APP_DOMAIN=${CWM_DOMAIN}|" .env
# _APP_CONSOLE_DOMAIN isn't in the installer-generated .env by default, so a
# plain sed would no-op. Replace if present, append if not.
if grep -q '^_APP_CONSOLE_DOMAIN=' .env; then
    sed -i "s|^_APP_CONSOLE_DOMAIN=.*|_APP_CONSOLE_DOMAIN=${CWM_DOMAIN}|" .env
else
    echo "_APP_CONSOLE_DOMAIN=${CWM_DOMAIN}" >> .env
fi
sed -i "s|^_APP_OPTIONS_FORCE_HTTPS=.*|_APP_OPTIONS_FORCE_HTTPS=enabled|" .env

# Upstream's mongodb service is the only one without a restart policy (every
# other appwrite-* container ships restart: unless-stopped). Its custom
# entrypoint can self-terminate after replica-set init in some races, leaving
# the whole stack DB-less with no recovery. Inject the policy here.
if ! grep -qE '^    restart:' <(sed -n '/^  mongodb:/,/^  [a-z]/p' docker-compose.yml); then
    echo "Adding restart: unless-stopped to mongodb service" | log
    sed -i '/^  mongodb:$/a\    restart: unless-stopped' docker-compose.yml
fi

echo "Starting Appwrite services" | log
docker compose up -d --remove-orphans 2>&1 | log
waitOrStop 0 "Failed to start Appwrite services"

echo "Waiting for Appwrite to initialize" | log
sleep 180

# Check if Appwrite is running
if ! curl -f -s "http://localhost" > /dev/null; then
    echo "Warning: Appwrite may still be starting up. This is normal on first installation." | log
fi

echo "Adding descriptions" | log
descriptionAppend "Appwrite Console: https://${CWM_DOMAIN}"
descriptionAppend "Appwrite API Endpoint: https://${CWM_DOMAIN}/v1"
descriptionAppend "Appwrite Secret Key: ${APPWRITE_SECRET}"
descriptionAppend " "
descriptionAppend "Appwrite config location: /opt/appwrite/appwrite/.env"
descriptionAppend "Appwrite compose file: /opt/appwrite/appwrite/docker-compose.yml"
descriptionAppend " "
descriptionAppend "IMPORTANT - First-time setup:"
descriptionAppend "1. Visit https://${CWM_DOMAIN} to access the Appwrite Console"
descriptionAppend "2. Sign up for a new account - THIS BECOMES YOUR ADMIN/ROOT USER"
descriptionAppend "3. The first user created automatically becomes the administrator"
descriptionAppend "4. After signing up, you'll be taken to the admin dashboard"
descriptionAppend "5. Create your first project to start using Appwrite"
descriptionAppend " "
descriptionAppend "Security Note:"
descriptionAppend "- Anyone can create the first user, so set it up immediately"
descriptionAppend "- After setup, consider disabling public registration in .env:"
descriptionAppend "  _APP_CONSOLE_WHITELIST_ROOT=disabled"
descriptionAppend "- TLS cert for ${CWM_DOMAIN} is issued automatically by Appwrite's"
descriptionAppend "  certificates worker on first HTTPS request. May take 1-2 minutes."
descriptionAppend "  If HTTPS doesn't work, check: docker logs appwrite-worker-certificates"
descriptionAppend " "
descriptionAppend "To manage Appwrite:"
descriptionAppend "  Start: cd /opt/appwrite/appwrite && docker compose start"
descriptionAppend "  Stop: cd /opt/appwrite/appwrite && docker compose stop"
descriptionAppend "  Restart: cd /opt/appwrite/appwrite && docker compose restart"
descriptionAppend "  View logs: cd /opt/appwrite/appwrite && docker compose logs -f"

tagScript success
exit 0
