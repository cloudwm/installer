#!/bin/bash

if [ -f "include/startup.sh" ]; then
    . include/startup.sh
elif [ -f "../include/startup.sh" ]; then
    . ../include/startup.sh
fi

echo "Installing Factorio Dedicated Server" | log

export DEBIAN_FRONTEND="noninteractive"
apt update
apt install -y apt-transport-https ca-certificates curl gnupg lsb-release

# Install Docker (if not already installed)
if ! command -v docker &> /dev/null; then
    echo "Installing Docker and Docker Compose" | log
    curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor -o /usr/share/keyrings/docker-archive-keyring.gpg
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/docker-archive-keyring.gpg] https://download.docker.com/linux/ubuntu $(lsb_release -cs) stable" > /etc/apt/sources.list.d/docker.list
    apt update
    apt install -y docker-ce docker-ce-cli containerd.io docker-compose-plugin
    sleep 5
fi

# Create Factorio directory
appInstallDir="/opt/factorio"
FACTORIO_PORT=34197
FACTORIO_RCON_PORT=27015
echo "Creating server directory: ${appInstallDir}" | log
mkdir -p ${appInstallDir}/data

# Generate RCON password
RCON_PASSWORD=$(openssl rand -base64 32 | tr -d /= | cut -c1-16)
echo "RCON Password: $RCON_PASSWORD" | log

# Write .env
cat << EOF > ${appInstallDir}/.env
FACTORIO_PORT=${FACTORIO_PORT}
FACTORIO_RCON_PORT=${FACTORIO_RCON_PORT}
FACTORIO_RCON_PASSWORD=${RCON_PASSWORD}
SERVER_NAME=${CWM_DOMAIN}
FACTORIO_VERSION=2.0.69
EOF

cat << 'EOF' > ${appInstallDir}/docker-compose.yml
services:
  factorio:
    image: factoriotools/factorio:${FACTORIO_VERSION}
    restart: unless-stopped
    ports:
      - "${FACTORIO_PORT}:34197/udp"
      - "${FACTORIO_RCON_PORT}:27015/tcp"
    volumes:
      - ./data:/factorio
    environment:
      - FACTORIO_SERVER_NAME=${SERVER_NAME}
      - FACTORIO_SERVER_DESCRIPTION=Dedicated server via Docker
      - FACTORIO_SERVER_MAX_PLAYERS=50
      - FACTORIO_SERVER_VISIBILITY_PUBLIC=true
      - FACTORIO_SERVER_GAME_PASSWORD=
      - FACTORIO_RCON_PASSWORD=${FACTORIO_RCON_PASSWORD}
      - FACTORIO_SAVE_NAME=dedicated
      - FACTORIO_GENERATE_NEW_SAVE=true
    networks:
      - factorio-net

networks:
  factorio-net:
    driver: bridge
EOF

# Start server
echo "Starting Factorio server..." | log
cd ${appInstallDir}
docker compose pull
docker compose up -d
waitOrStop 0 "Failed to start Factorio server"

sleep 30

# Static landing page. Factorio has no HTTP UI of its own; this gives anyone who
# hits the host in a browser the in-game connect string instead of a refused
# connection. nginx + cert come from tweaks/nginx-letsencrypt-cert in the contrib.
echo "Writing Factorio landing page" | log
mkdir -p /var/www/factorio
cat << 'EOF' > /var/www/factorio/index.html
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Factorio Server — __DOMAIN__</title>
<style>
  body { font-family: 'Helvetica Neue', Arial, sans-serif; margin: 0; padding: 40px 20px; background: #121212; color: #E0E0E0; min-height: 100vh; }
  .card { max-width: 640px; margin: 0 auto; background: #1E1E1E; border-radius: 12px; padding: 32px; box-shadow: 0 8px 24px rgba(0,0,0,0.4); }
  h1 { margin: 0 0 8px; color: #F5A940; font-size: 28px; }
  .sub { color: #888; margin-bottom: 24px; }
  .row { background: #000; border: 1px solid #169307; border-radius: 6px; padding: 14px 16px; margin: 10px 0; font-family: 'Courier New', monospace; display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .label { color: #888; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px; }
  .value { color: #00cc00; font-size: 16px; word-break: break-all; }
  .copy { background: #169307; color: #fff; border: none; padding: 6px 12px; border-radius: 4px; cursor: pointer; font-size: 12px; }
  .copy:hover { background: #1eb009; }
  .note { color: #888; font-size: 13px; margin-top: 24px; line-height: 1.5; }
</style>
</head>
<body>
  <div class="card">
    <h1>Factorio Dedicated Server</h1>
    <div class="sub">This is a game server. Connect from inside Factorio — there is no web UI.</div>

    <div class="row">
      <div>
        <div class="label">In-game address</div>
        <div class="value" id="addr">__DOMAIN__:__PORT__</div>
      </div>
      <button class="copy" onclick="navigator.clipboard.writeText(document.getElementById('addr').innerText)">Copy</button>
    </div>

    <div class="row">
      <div>
        <div class="label">RCON port</div>
        <div class="value">__RCON_PORT__</div>
      </div>
    </div>

    <div class="row">
      <div>
        <div class="label">RCON password</div>
        <div class="value" id="rcon">__RCON_PASS__</div>
      </div>
      <button class="copy" onclick="navigator.clipboard.writeText(document.getElementById('rcon').innerText)">Copy</button>
    </div>

    <div class="note">In Factorio: <em>Multiplayer → Connect to address</em>, paste the address above.</div>
  </div>
</body>
</html>
EOF
sed -i "s|__DOMAIN__|${CWM_DOMAIN}|g; s|__PORT__|${FACTORIO_PORT}|g; s|__RCON_PORT__|${FACTORIO_RCON_PORT}|g; s|__RCON_PASS__|${RCON_PASSWORD}|g" /var/www/factorio/index.html

echo "Writing nginx vhost for Factorio landing page" | log
cat << EOF > /etc/nginx/sites-available/factorio
server {
    listen 80;
    server_name ${CWM_DOMAIN};
    return 301 https://\$server_name\$request_uri;
}
server {
    listen 443 ssl http2;
    server_name ${CWM_DOMAIN};
    ssl_certificate     /etc/letsencrypt/live/${CWM_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${CWM_DOMAIN}/privkey.pem;

    root /var/www/factorio;
    index index.html;

    location / {
        try_files \$uri \$uri/ =404;
    }
}
EOF
ln -sf /etc/nginx/sites-available/factorio /etc/nginx/sites-enabled/factorio
rm -f /etc/nginx/sites-enabled/default
nginx -t 2>&1 | log
systemctl enable nginx
systemctl restart nginx
waitOrStop 0 "Failed to restart nginx for Factorio landing page"

# Final info
descriptionAppend "Factorio Server Running!"
descriptionAppend "Connect in-game: ${CWM_DOMAIN}:${FACTORIO_PORT}"
descriptionAppend "Web: https://${CWM_DOMAIN}/"
descriptionAppend "RCON: ${FACTORIO_RCON_PORT} | Password: ${RCON_PASSWORD}"
descriptionAppend "Data: ${appInstallDir}/data"
descriptionAppend "Docker Compose: ${appInstallDir}/docker-compose.yml"
descriptionAppend " "
descriptionAppend "Commands:"
descriptionAppend "  docker compose -f ${appInstallDir}/docker-compose.yml logs -f"
descriptionAppend "  docker compose -f ${appInstallDir}/docker-compose.yml down"
descriptionAppend "  docker compose -f ${appInstallDir}/docker-compose.yml up -d"
descriptionAppend "  docker exec -it \$(docker ps -qf 'name=factorio') rcon"
descriptionAppend " "
descriptionAppend "Tip: Edit .env or docker-compose.yml → then 'up -d' to apply."

tagScript success
exit 0
