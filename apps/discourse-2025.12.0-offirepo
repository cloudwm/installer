#!/bin/bash

if [ -f "include/startup.sh" ]; then
    . include/startup.sh
elif [ -f "../include/startup.sh" ]; then
    . ../include/startup.sh
fi

DISCOURSE_DIR="/var/discourse"
APP_NAME="app"
MIN_FREE_GB=10
# Container serves plain HTTP on this localhost-only port; host nginx terminates
# TLS and reverse-proxies to it (see vhost below). This decouples Discourse from
# its built-in Let's Encrypt template, which leaves nginx crash-looping (and the
# whole app unreachable) whenever LE can't validate the domain — e.g. a private-IP
# dev-cloud-xip.com VM.
APP_HTTP_PORT=8080
LE_DIR="/etc/letsencrypt/live/${CWM_DOMAIN}"

echo "Installing Discourse Forum with Docker + Nginx + SSL" | log

# Discourse's launcher refuses to bootstrap with <5GB free on /var/lib/docker.
# The base image alone is ~5GB, the bootstrapped app image is another ~3-4GB,
# plus Postgres/Redis data + logs. 10 GB free at start is the practical minimum.
echo "Checking free disk on /var/lib/docker volume" | log
mkdir -p /var/lib/docker
freeGB=$(df -BG --output=avail /var/lib/docker | tail -1 | tr -dc '0-9')
if [ -z "$freeGB" ] || [ "$freeGB" -lt "$MIN_FREE_GB" ]; then
    df -h /var/lib/docker | log
    echo "ERROR: Less than ${MIN_FREE_GB} GB free on the volume hosting /var/lib/docker. Discourse cannot bootstrap. Provision a VM with at least 20 GB root disk (30+ GB recommended)." | log 1
    exit 1
fi
echo "Free disk OK (${freeGB} GB)" | log

echo "Updating system packages..." | log
apt-get update -q
apt-get upgrade -yq
apt-get install -yq curl wget certbot 

echo "Installing Docker..." | log
if ! command -v docker &> /dev/null; then
    curl -fsSL https://get.docker.com -o get-docker.sh
    sh get-docker.sh
    rm get-docker.sh
    systemctl enable docker
    systemctl start docker
    echo "Docker installed." | log
else
    echo "Docker already installed." | log
fi

echo "Setting up Discourse..." | log
git clone https://github.com/discourse/discourse_docker.git "$DISCOURSE_DIR"
cd "$DISCOURSE_DIR"

echo "Creating configuration..." | log
cat > "${DISCOURSE_DIR}/containers/${APP_NAME}.yml" << EOF
templates:
  - "templates/postgres.template.yml"
  - "templates/redis.template.yml"
  - "templates/web.template.yml"
expose:
  - "127.0.0.1:${APP_HTTP_PORT}:80"
params:
  db_default_text_search_config: "pg_catalog.english"
  db_shared_buffers: "256MB"
env:
  DISCOURSE_VERSION: v2025.12.0-latest
  LANG: en_US.UTF-8
  DISCOURSE_DEFAULT_LOCALE: en

  ## Hostname
  DISCOURSE_HOSTNAME: '${CWM_DOMAIN}'

  ## Email
  DISCOURSE_DEVELOPER_EMAILS: '${ADMINEMAIL}'

  ## Uncomment if using a mail service that requires authentication
  # DISCOURSE_SMTP_AUTHENTICATION: login
  # DISCOURSE_SMTP_ENABLE_START_TLS: true
volumes:
  - volume:
      host: /var/discourse/shared/standalone
      guest: /shared
  - volume:
      host: /var/discourse/shared/standalone/log/var-log
      guest: /var/log
hooks:
  after_code:
    - exec:
        cd: \$home/plugins
        cmd:
          - git clone https://github.com/discourse/docker_manager.git
run:
  - exec: echo "Beginning of custom commands"
  - exec: echo "End of custom commands"
EOF

echo "Configuration created at: ${DISCOURSE_DIR}/containers/${APP_NAME}.yml" | log

echo "Bootstrapping Discourse container (this can take 10+ minutes)..." | log
./launcher bootstrap ${APP_NAME} 2>&1 | log
waitOrStop 0 "launcher bootstrap failed"

echo "Starting Discourse..." | log
./launcher start ${APP_NAME} 2>&1 | log
waitOrStop 0 "launcher start failed"

echo "Waiting for Discourse to become available..." | log
discourse_up=0
for i in {1..30}; do
    if curl -f -s -o /dev/null "http://127.0.0.1:${APP_HTTP_PORT}"; then
        echo "Discourse is running!" | log
        discourse_up=1
        break
    fi
    echo "Waiting... (${i}/30)" | log
    sleep 10
done
[ "$discourse_up" = "1" ]
waitOrStop 0 "Discourse did not respond on http://127.0.0.1:${APP_HTTP_PORT} after 5 minutes"

echo "Configuring host Nginx reverse-proxy for Discourse (HTTPS)" | log
# Certs provided by tweaks/nginx-letsencrypt-cert (run earlier in the contrib):
# a real LE cert when the domain is publicly reachable, otherwise a self-signed
# fallback — either way the files exist so nginx always starts.
cat << EOF > /etc/nginx/sites-available/discourse
server {
    listen 80;
    listen [::]:80;
    server_name ${CWM_DOMAIN};
    return 301 https://\$host\$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ${CWM_DOMAIN};
    ssl_certificate     ${LE_DIR}/fullchain.pem;
    ssl_certificate_key ${LE_DIR}/privkey.pem;

    client_max_body_size 100m;

    location / {
        proxy_pass http://127.0.0.1:${APP_HTTP_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 300s;
    }
}
EOF
ln -sf /etc/nginx/sites-available/discourse /etc/nginx/sites-enabled/
rm -f /etc/nginx/sites-enabled/default
nginx -t
waitOrStop 0 "Nginx configuration test failed"
systemctl enable nginx
systemctl restart nginx
waitOrStop 0 "Failed to restart Nginx"

echo "Adding Nginx ports to ufw" | log
ufw allow 80
ufw allow 443

GEN_PASS=$(openssl rand -base64 32 | head -c 15)

echo "Creating admin account..." | log
sleep 5
./launcher enter ${APP_NAME} <<EOFCMD
cd /var/www/discourse
sudo -u discourse RAILS_ENV=production bundle exec rake admin:create <<ADMINEOF
${ADMINEMAIL}
${GEN_PASS}
${GEN_PASS}
y
ADMINEOF
EOFCMD

descriptionAppend "Discourse Forum Installation Complete!"
descriptionAppend ""
descriptionAppend "🌐 Forum URL: https://${CWM_DOMAIN}/signup"
descriptionAppend "Visit the URL to create your new account, your email in linked to admin privileges"
descriptionAppend "👤 Admin Account:"
descriptionAppend "  Email: ${ADMINEMAIL}"
descriptionAppend "  Password: ${GEN_PASS}"
descriptionAppend ""
descriptionAppend "📁 Important Files:"
descriptionAppend "  Configuration: ${DISCOURSE_DIR}/containers/${APP_NAME}.yml"
descriptionAppend "  Discourse Dir: ${DISCOURSE_DIR}"
descriptionAppend ""

tagScript success
exit 0
