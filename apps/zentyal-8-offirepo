#!/bin/bash

# Load startup script
if [ -f "include/startup.sh" ]; then
    . include/startup.sh
elif [ -f "../include/startup.sh" ]; then
    . ../include/startup.sh
fi

aptSourceList=/etc/apt/sources.list.d/zentyal.list
rootDir=$(rootDir)

echo "Modifying hostname to fit max 64 chars requirement" | log
savedHostname=$(hostname)
hostnamectl set-hostname ${savedHostname::32}

echo "Installing Zentyal 8.0 with graphical environment" | log

# Download and patch the installer to auto-confirm graphical environment
wget https://raw.githubusercontent.com/zentyal/zentyal/master/extra/ubuntu_installers/zentyal_installer_8.0.sh
chmod u+x zentyal_installer_8.0.sh

# Patch the script: replace the prompt with default 'y'
sed -i '/read ZEN_GUI/i\ZEN_GUI="n"' zentyal_installer_8.0.sh
sed -i '/read ZEN_GUI/d' zentyal_installer_8.0.sh

# Run the modified installer
./zentyal_installer_8.0.sh

echo "Creating admin user and disabling ssh login to admin" | log
useradd admin -s /bin/bash -m -g users -G sudo
chpasswd <<< "admin:${ADMINPASSWORD}"
echo "DenyUsers admin" | sudo tee -a /etc/ssh/sshd_config
systemctl restart sshd

echo "Configuring nginx reverse proxy in front of Zentyal admin (8443)" | log
mkdir -p /var/www/letsencrypt
cat << EOF > /etc/nginx/sites-available/zentyal
server {
    listen 80;
    server_name ${CWM_DOMAIN};
    # Keep the ACME HTTP-01 webroot reachable so certs can renew (and the
    # self-heal retry below can upgrade a self-signed fallback) without
    # stopping nginx; everything else redirects to https.
    location /.well-known/acme-challenge/ { root /var/www/letsencrypt; }
    location / { return 301 https://\$server_name\$request_uri; }
}
server {
    listen 443 ssl http2;
    server_name ${CWM_DOMAIN};
    ssl_certificate /etc/letsencrypt/live/${CWM_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${CWM_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    client_max_body_size 0;

    location / {
        proxy_pass https://127.0.0.1:8443;
        proxy_ssl_verify off;                       # Zentyal serves a self-signed cert on 8443
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_http_version 1.1;
        proxy_buffering off;
    }
}
EOF

ln -sf /etc/nginx/sites-available/zentyal /etc/nginx/sites-enabled/
rm -f /etc/nginx/sites-enabled/default
# Zentyal's install disables the stock nginx (it manages its own on 8443); re-enable here,
# after the Zentyal install, so the proxy survives the CWM provisioning reboot.
systemctl enable nginx
systemctl restart nginx
waitOrStop 0 "Failed to restart nginx after Zentyal proxy config"

# The xip-style CWM_DOMAIN DNS is intermittently unresolvable by Let's Encrypt's
# validators, so nginx-letsencrypt-cert may have left a self-signed cert. Install
# a self-healing retry that issues a real cert via the nginx webroot once DNS
# cooperates, copies it into the path nginx serves, reloads nginx, and removes
# its own cron. The deploy-hook also keeps future renewals propagating + reloading.
LE_DIR="/etc/letsencrypt/live/${CWM_DOMAIN}"
cat <<EOF > /usr/local/bin/zentyal-ssl-retry.sh
#!/bin/bash
D="${CWM_DOMAIN}"
WR=/var/www/letsencrypt
LIVE="${LE_DIR}"
remove_cron() { crontab -l 2>/dev/null | grep -v 'zentyal-ssl-retry' | crontab - ; }
if openssl x509 -in "\$LIVE/fullchain.pem" -noout -issuer 2>/dev/null | grep -q "Let's Encrypt"; then
    remove_cron; exit 0
fi
if certbot certonly --webroot -w "\$WR" -d "\$D" --cert-name zentyal-le \\
     --non-interactive --agree-tos -m "admin@\$D" --keep-until-expiring \\
     --deploy-hook "cp -fL /etc/letsencrypt/live/zentyal-le/fullchain.pem \$LIVE/fullchain.pem; cp -fL /etc/letsencrypt/live/zentyal-le/privkey.pem \$LIVE/privkey.pem; systemctl reload nginx"; then
    openssl x509 -in "\$LIVE/fullchain.pem" -noout -issuer 2>/dev/null | grep -q "Let's Encrypt" && remove_cron
fi
EOF
chmod +x /usr/local/bin/zentyal-ssl-retry.sh
( crontab -l 2>/dev/null | grep -v zentyal-ssl-retry; \
  echo '*/20 * * * * /usr/local/bin/zentyal-ssl-retry.sh >> /var/log/zentyal-ssl-retry.log 2>&1' ) | crontab -
/usr/local/bin/zentyal-ssl-retry.sh >> /var/log/zentyal-ssl-retry.log 2>&1 || true

echo "Adding descriptions" | log
descriptionAppend "Zentyal Admin URI: https://${CWM_DOMAIN}"
descriptionAppend "Zentyal Admin User: admin"
descriptionAppend "Zentyal Admin Password: ${ADMINPASSWORD}"
descriptionAppend " "

tagScript success

exit 0

