#!/bin/bash

# Source startup script if available
if [ -f "include/startup.sh" ]; then
    . include/startup.sh
elif [ -f "../include/startup.sh" ]; then
    . ../include/startup.sh
fi

echo "Starting Netdata installation" | log
export DEBIAN_FRONTEND="noninteractive"

# Download the Netdata kickstart script
echo "Downloading Netdata kickstart script" | log
curlDownload https://get.netdata.cloud/kickstart.sh /tmp/netdata-kickstart.sh

# Install Netdata
echo "Installing Netdata" | log
# --non-interactive : unattended install
# --stable-channel  : production stability
# --no-updates      : disable auto-updates (controlled manually)
sh /tmp/netdata-kickstart.sh --non-interactive --stable-channel --no-updates 2>&1 | log
waitOrStop 0 "Failed to install Netdata"

echo "Starting Netdata service" | log
systemctl start netdata
systemctl enable netdata

# Bind Netdata to localhost only — host nginx is the public interface.
echo "Configuring Netdata to listen on localhost only" | log
mkdir -p /etc/netdata
cat << EOF > /etc/netdata/netdata.conf
[web]
    bind to = 127.0.0.1:19999
EOF
systemctl restart netdata

echo "Configuring Nginx for Netdata (HTTPS)" | log
# nginx + LE cert provided by tweaks/nginx-letsencrypt-cert (run earlier in
# the contrib). Certs at /etc/letsencrypt/live/${CWM_DOMAIN}/{fullchain,privkey}.pem.
cat << EOF > /etc/nginx/sites-available/netdata
server {
    listen 80;
    listen [::]:80;
    server_name ${CWM_DOMAIN};
    return 301 https://\$host\$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ${CWM_DOMAIN};
    ssl_certificate     /etc/letsencrypt/live/${CWM_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${CWM_DOMAIN}/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:19999;
        proxy_http_version 1.1;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 300s;
    }
}
EOF
ln -sf /etc/nginx/sites-available/netdata /etc/nginx/sites-enabled/
rm -f /etc/nginx/sites-enabled/default
nginx -t
waitOrStop 0 "Nginx configuration test failed"
systemctl enable nginx
systemctl restart nginx
waitOrStop 0 "Failed to restart Nginx"

echo "Adding Nginx ports to ufw" | log
ufw allow 80
ufw allow 443

echo "Adding descriptions" | log
descriptionAppend "Netdata Dashboard: https://${CWM_DOMAIN}/"
descriptionAppend " "
descriptionAppend "Netdata Configuration: /etc/netdata/netdata.conf"
descriptionAppend "Netdata Data Directory: /var/cache/netdata"
descriptionAppend "Netdata Log Directory: /var/log/netdata"
descriptionAppend "Nginx vhost: /etc/nginx/sites-available/netdata"
descriptionAppend " "
descriptionAppend "To edit Netdata config: /etc/netdata/edit-config netdata.conf"
descriptionAppend "To restart Netdata: systemctl restart netdata"
descriptionAppend "To view Netdata logs: journalctl -u netdata -f"

tagScript success

exit 0
