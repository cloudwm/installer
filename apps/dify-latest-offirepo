#!/bin/bash
# Add this at the beginning of all scripts.
if [ -f "include/startup.sh" ]; then
    . include/startup.sh
elif [ -f "../include/startup.sh" ]; then
    . ../include/startup.sh
fi

rootDir=$(rootDir)

echo "Installing Dify (self-hosted) with Docker Compose, Nginx + Let's Encrypt" | log

export DEBIAN_FRONTEND="noninteractive"

apt-get update
installPackage curl git ca-certificates gnupg lsb-release apt-transport-https openssl jq

if ! command -v docker &> /dev/null; then
    echo "Installing Docker" | log
    install -m 0755 -d /etc/apt/keyrings
    curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg
    chmod a+r /etc/apt/keyrings/docker.gpg
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu $(lsb_release -cs) stable" | tee /etc/apt/sources.list.d/docker.list > /dev/null
    apt-get update
    installPackage docker-ce docker-ce-cli containerd.io docker-compose-plugin
fi

systemctl enable docker
systemctl start docker
waitOrStop 0 "Docker service failed to start"

echo "Docker Compose version: $(docker compose version --short 2>/dev/null) (Dify requires 2.35.0+)" | log

APP_DIR="/opt/dify"
rm -rf "$APP_DIR"
git clone https://github.com/langgenius/dify.git "$APP_DIR"
waitOrStop 0 "Failed to clone the Dify repository"

cd "$APP_DIR/docker"
waitOrStop 0 "Cannot cd to $APP_DIR/docker"

echo "Writing docker/.env" | log
cp .env.example .env

# Secrets - generated by the installer instead of relying on CWM's one-shot
# ADMINPASSWORD global, which is only exported into the first contrib script's
# own process and arrives empty here.
sandboxToken=$(openssl rand -hex 32)
pluginDaemonKey=$(openssl rand -hex 32)
innerApiKey=$(openssl rand -hex 32)
sandboxApiKey=$(openssl rand -hex 32)
# InitValidatePayload.password caps at 30 chars server-side; hex 16 (32 chars)
# fails with a 422. Hex 12 (24 chars) stays under the cap.
initPassword=$(openssl rand -hex 12)
adminEmail="admin@${CWM_DOMAIN}"
adminPassword=$(openssl rand -hex 16)

sed -i "s|^DIFY_AGENT_LOCAL_SANDBOX_AUTH_TOKEN=.*|DIFY_AGENT_LOCAL_SANDBOX_AUTH_TOKEN=${sandboxToken}|" .env

# PLUGIN_DAEMON_KEY / PLUGIN_DIFY_INNER_API_KEY / SANDBOX_API_KEY+CODE_EXECUTION_API_KEY
# are not required to boot (they ship with bundled defaults) but the Dify docs
# call out replacing them before production use.
cat << EOF >> .env

# Shared plugin credentials - generated by the installer
PLUGIN_DAEMON_KEY=${pluginDaemonKey}
PLUGIN_DIFY_INNER_API_KEY=${innerApiKey}

# Code sandbox credential - generated by the installer
SANDBOX_API_KEY=${sandboxApiKey}
CODE_EXECUTION_API_KEY=${sandboxApiKey}
EOF

echo "Gating the /install setup wizard with a one-time password" | log
cat << EOF > envs/security.env
INIT_PASSWORD=${initPassword}
EOF

# Dify's bundled nginx container does its own port publishing; the CWM
# environment terminates TLS on the host nginx (cert from
# tweaks/nginx-letsencrypt-cert), so bind the container to loopback only.
# A docker-compose.override.yml was tried first, but Compose appends to the
# base ports: list instead of replacing it, so the container ended up bound
# to 0.0.0.0:80/:443 *and* 127.0.0.1:8080 at once - whichever of the Dify
# container or the host nginx started first on reboot won those ports and
# the other failed with "address already in use". Redirecting the base
# file's own EXPOSE_NGINX_PORT/EXPOSE_NGINX_SSL_PORT variables avoids a
# second ports: entry entirely, so there is only ever one binding.
cat << 'EOF' >> .env

# Loopback-only nginx publishing - host nginx terminates TLS and proxies here
EXPOSE_NGINX_PORT=127.0.0.1:8080
EXPOSE_NGINX_SSL_PORT=127.0.0.1:8443
EOF

echo "Validating the Compose configuration" | log
docker compose config --quiet
waitOrStop 0 "Dify Compose configuration is invalid"

echo "Pulling Dify images (the bundled stack is ~15 containers, this can take a while)" | log
docker compose pull
docker compose up -d
waitOrStop 0 "Failed to start Dify services"

echo "Waiting for Dify to accept connections" | log
difyUp=1
for attempt in $(seq 1 60); do
    if curl -fsS http://127.0.0.1:8080/ > /dev/null 2>&1; then
        difyUp=0
        break
    fi
    sleep 10
done

if [ $difyUp -ne 0 ]; then
    docker compose ps --all | log 1
    docker compose logs --tail 80 api nginx | log 1
    echo "Dify did not become reachable in time. exiting (1)." | log 1
    exit 1
fi
echo "Dify is reachable" | log

# Drive the first-run /install wizard ourselves (POST /console/api/init then
# /console/api/setup, the same two calls the browser wizard makes) so the
# install finishes with a working admin login instead of leaving a manual
# step. Talk to the loopback port directly - it's the same nginx container
# the browser would otherwise reach through the host proxy.
echo "Automating the first-run setup wizard" | log
cookieJar="$rootDir/temp/dify-cookies.txt"
rm -f "$cookieJar"

initHttp=$(curl -sS -o "$rootDir/temp/dify-init.json" -w '%{http_code}' \
    -c "$cookieJar" -b "$cookieJar" \
    -H 'Content-Type: application/json' \
    -X POST "http://127.0.0.1:8080/console/api/init" \
    -d "{\"password\":\"${initPassword}\"}")

setupOk=0
if [ "$initHttp" = "201" ]; then
    setupHttp=$(curl -sS -o "$rootDir/temp/dify-setup.json" -w '%{http_code}' \
        -c "$cookieJar" -b "$cookieJar" \
        -H 'Content-Type: application/json' \
        -X POST "http://127.0.0.1:8080/console/api/setup" \
        -d "{\"email\":\"${adminEmail}\",\"name\":\"Admin\",\"password\":\"${adminPassword}\",\"language\":\"en-US\"}")
    [ "$setupHttp" = "201" ] && setupOk=1
fi

if [ "$setupOk" -eq 1 ]; then
    echo "Dify admin account created automatically" | log
else
    echo "Automated setup did not complete (init:${initHttp:-n/a}, setup:${setupHttp:-n/a})" | log
    cat "$rootDir/temp/dify-init.json" "$rootDir/temp/dify-setup.json" 2>/dev/null | log
    echo "Falling back to the manual /install wizard" | log
fi
rm -f "$cookieJar" "$rootDir/temp/dify-init.json" "$rootDir/temp/dify-setup.json"

echo "Configuring Nginx reverse proxy for HTTPS" | log
cat << EOF > /etc/nginx/sites-available/dify
server {
    listen 80;
    server_name ${CWM_DOMAIN};
    return 301 https://\$server_name\$request_uri;
}

server {
    listen 443 ssl http2;
    server_name ${CWM_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${CWM_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${CWM_DOMAIN}/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;

    client_max_body_size 100M;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
EOF

ln -sf /etc/nginx/sites-available/dify /etc/nginx/sites-enabled/
rm -f /etc/nginx/sites-enabled/default 2>/dev/null
nginx -t
waitOrStop 0 "Nginx configuration test failed"
systemctl enable nginx
systemctl restart nginx
waitOrStop 0 "Failed to restart Nginx"

echo "Adding Nginx ports to ufw" | log
ufw allow 80
ufw allow 443

echo "Setting up automatic SSL certificate renewal" | log
systemctl enable certbot.timer
systemctl start certbot.timer

echo "Adding descriptions" | log
descriptionAppend "Dify Web UI / API: https://${CWM_DOMAIN}"
if [ "$setupOk" -eq 1 ]; then
    descriptionAppend "Admin account was created automatically - log in with:"
    descriptionAppend "   Email: ${adminEmail}"
    descriptionAppend "   Password: ${adminPassword}"
else
    descriptionAppend "Automated setup did not finish - complete it manually:"
    descriptionAppend "First-run setup wizard: https://${CWM_DOMAIN}/install"
    descriptionAppend "Setup password (enter once on the /install page): ${initPassword}"
    descriptionAppend "After entering it you will create the first (owner) account yourself."
fi
descriptionAppend " "
descriptionAppend "Installation path: ${APP_DIR}/docker"
descriptionAppend "Compose file: ${APP_DIR}/docker/docker-compose.yaml"
descriptionAppend "Environment file: ${APP_DIR}/docker/.env"
descriptionAppend "Nginx vhost: /etc/nginx/sites-available/dify"
descriptionAppend " "
descriptionAppend "Generated credentials (also saved in docker/.env and docker/envs/security.env):"
descriptionAppend "   DIFY_AGENT_LOCAL_SANDBOX_AUTH_TOKEN=${sandboxToken}"
descriptionAppend "   PLUGIN_DAEMON_KEY=${pluginDaemonKey}"
descriptionAppend "   PLUGIN_DIFY_INNER_API_KEY=${innerApiKey}"
descriptionAppend "   SANDBOX_API_KEY / CODE_EXECUTION_API_KEY=${sandboxApiKey}"
descriptionAppend " "
descriptionAppend "Dify bundles Postgres, Redis, Weaviate, the code sandbox, plugin daemon"
descriptionAppend "and nginx (12+ containers) - give this instance 4GB+ RAM."

tagScript success

exit 0
