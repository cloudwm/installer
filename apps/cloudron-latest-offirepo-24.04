#!/bin/bash

if [ -f "include/startup.sh" ]; then
    . include/startup.sh
elif [ -f "../include/startup.sh" ]; then
    . ../include/startup.sh
fi

set -o pipefail

if [ -z "$CWM_DOMAIN" ]; then
    echo "Error: CWM_DOMAIN is empty. Cloudron's setup wizard needs a real hostname pointing at this VM." | log 1
    exit 1
fi

echo "Downloading and installing CloudRon" | log
curlDownload https://cloudron.io/cloudron-setup
chmod u+x cloudron-setup

echo "Enabling and starting cron service..." | log
systemctl enable cron
systemctl start cron

ubuntu_version=$(lsb_release -rs)
if [[ "$ubuntu_version" == "24.04" ]]; then
    echo "Adding shutdown cron job to root's crontab for Ubuntu 24..." | log
    CRON_JOB="@reboot ( /sbin/shutdown now; crontab -l | grep -v '@reboot /sbin/shutdown now' | crontab - )"
    (crontab -l 2>/dev/null | grep -F "$CRON_JOB") || (crontab -l 2>/dev/null; echo "$CRON_JOB") | crontab -
    echo "Shutdown cron job added successfully. The system will shut down on next reboot." | log
else
    echo "This is not Ubuntu 24. Shutdown cron job will not be added." | log
fi

# Cloudron's setup wizard POSTs /api/v1/provision/detect_ip on every page load
# of /setup.html, which calls https://ipv6.api.cloudron.io (AAAA-only host).
# On VMs without a default IPv6 route the TCP SYN hangs for the full 30s
# superagent timeout, making the wizard appear blank for ~30s on first load.
# If this VM has no public IPv6, install one ip6tables OUTPUT REJECT rule so
# the call fails in ms instead of seconds. Skipped if a default v6 route
# exists, so dual-stack VMs keep working unchanged.
if ! ip -6 route show default 2>/dev/null | grep -q .; then
    echo "No default IPv6 route detected; rejecting outbound TCP/IPv6 to speed up Cloudron setup wizard" | log
    installPackage iptables-persistent
    ip6tables -C OUTPUT -p tcp -j REJECT --reject-with adm-prohibited 2>/dev/null \
        || ip6tables -I OUTPUT -p tcp -j REJECT --reject-with adm-prohibited
    netfilter-persistent save 2>&1 | log
fi

echo "Running CloudRon setup..." | log
# cloudron-setup writes its detailed log to /var/log/cloudron-setup.log; stdout
# is a sparse progress stream. Pipe through tee so both go to the installer
# log, and rely on set -o pipefail so a non-zero exit from cloudron-setup is
# preserved despite the pipe.
if ! echo Y | bash cloudron-setup 2>&1 | tee -a "${CWM_LOGDIR:-/root}/cloudron-setup.stdout.log" | log; then
    rc=$?
    echo "cloudron-setup failed with exit $rc. Last 40 lines of /var/log/cloudron-setup.log:" | log 1
    tail -n 40 /var/log/cloudron-setup.log 2>&1 | log 1
    exit 1
fi

echo "Adding descriptions" | log
descriptionAppend "CloudRon Web UI: https://${CWM_DOMAIN}"
descriptionAppend "Open the URL in your browser and complete the setup wizard."
descriptionAppend "Cloudron issues its own Let's Encrypt cert after the wizard."

echo "Cleaning up..." | log
apt-get autoremove -y
apt-get autoclean -y

tagScript success
exit 0
