#!/bin/bash

if [ -f "include/startup.sh" ]; then
    . include/startup.sh
elif [ -f "../include/startup.sh" ]; then
    . ../include/startup.sh
fi

appPath=/var/flowise
rootDir=$(rootDir)
MIN_FREE_GB=12
flowiseImage="flowiseai/flowise:3.1.4"

echo "Checking free disk on /var/lib/docker volume" | log
mkdir -p /var/lib/docker
freeGB=$(df -BG --output=avail /var/lib/docker | tail -1 | tr -dc '0-9')
if [ -z "$freeGB" ] || [ "$freeGB" -lt "$MIN_FREE_GB" ]; then
    df -h /var/lib/docker | log
    echo "ERROR: Less than ${MIN_FREE_GB} GB free on the volume hosting /var/lib/docker. Flowise's Docker image is ~9-10 GB on disk and cannot be pulled. Provision a VM with at least 20 GB root disk." | log 1
    exit 1
fi
echo "Free disk OK (${freeGB} GB)" | log

echo "Installing Docker dependencies" | log
installPackage curl git
waitOrStop 0 "Failed to install dependencies"

echo "Installing Docker" | log
curl -fsSL https://get.docker.com -o get-docker.sh
sh get-docker.sh
waitOrStop 0 "Failed to install Docker"

echo "Cloning Flowise repository" | log
git clone https://github.com/FlowiseAI/Flowise.git $appPath
waitOrStop 0 "Failed to clone Flowise repository"

cd $appPath/docker
cp .env.example .env
sed -i "s|^FLOWISE_USERNAME=.*|FLOWISE_USERNAME=${ADMINEMAIL}|" .env
sed -i "s|^FLOWISE_PASSWORD=.*|FLOWISE_PASSWORD=${ADMINPASSWORD}|" .env
# Pin the Flowise image to the version this file is named for.
# WARNING: 3.1.4 (the newest release at time of writing) is known to crash-loop
# at node load with ERR_PACKAGE_PATH_NOT_EXPORTED ("./utils/uuid") due to a
# broken @langchain/core in the image. This file exists to pin the current
# latest on request; if the container does not come up, the last version
# verified healthy is 3.0.13 (see apps/flowise-latest-offirepo).
sed -i -E "s|image:[[:space:]]*flowiseai/flowise(:[^[:space:]]*)?|image: ${flowiseImage}|" docker-compose.yml

# The image runs as the non-root `node` user (uid 1000) and bind-mounts
# ~/.flowise -> /home/node/.flowise. Two things break a fresh start:
#   1. Docker auto-creates the missing host dir root-owned, so `node` gets EACCES
#      doing mkdir('/home/node/.flowise/storage'). Pre-create it and chown to 1000.
#   2. docker-compose.yml forwards DATABASE_PATH/SECRETKEY_PATH/LOG_PATH/etc.
#      unconditionally; commented out in .env they reach the container EMPTY, so
#      it opens an empty DB path (SQLITE_CANTOPEN) and mkdirSync('') for logs.
#      Pin them all inside the mounted volume so every writable path is one the
#      `node` user owns. (This replaces the old fragile /var/log/flowise mount,
#      whose sed matched an upstream mount target that no longer exists.)
flowiseHome="${HOME:-/root}/.flowise"
mkdir -p "${flowiseHome}"
chown -R 1000:1000 "${flowiseHome}"
cat >> .env <<'ENVEOF'

# Writable paths pinned into the mounted /home/node/.flowise volume (install script)
DATABASE_PATH=/home/node/.flowise
SECRETKEY_PATH=/home/node/.flowise
APIKEY_PATH=/home/node/.flowise
BLOB_STORAGE_PATH=/home/node/.flowise/storage
LOG_PATH=/home/node/.flowise/logs
ENVEOF
chmod -R 755 $appPath

echo "Starting Flowise with Docker Compose" | log
docker compose up -d
waitOrStop 0 "Failed to start Flowise with Docker Compose"

echo "Adding Flowise port to ufw" | log
ufw allow 3000

echo "Configuring Nginx for Flowise (HTTPS)" | log
# nginx + LE cert provided by tweaks/nginx-letsencrypt-cert (run earlier in
# the contrib). Certs at /etc/letsencrypt/live/${CWM_DOMAIN}/{fullchain,privkey}.pem.
cat << EOF > /etc/nginx/sites-available/flowise
server {
    listen 80;
    listen [::]:80;
    server_name ${CWM_DOMAIN};
    return 301 https://\$host\$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ${CWM_DOMAIN};
    ssl_certificate     /etc/letsencrypt/live/${CWM_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${CWM_DOMAIN}/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 300s;
    }
}
EOF
ln -sf /etc/nginx/sites-available/flowise /etc/nginx/sites-enabled/
rm -f /etc/nginx/sites-enabled/default
nginx -t
waitOrStop 0 "Nginx configuration test failed"
systemctl enable nginx
systemctl restart nginx
waitOrStop 0 "Failed to restart Nginx"
echo "Adding Nginx ports to ufw" | log
ufw allow 80
ufw allow 443

echo "Adding descriptions" | log
descriptionAppend "Flowise is installed and running with Docker."
descriptionAppend "Flowise repository directory: $appPath"
descriptionAppend "Flowise Web UI: https://${CWM_DOMAIN}/"
descriptionAppend "To stop Flowise: cd $appPath/docker && docker compose down"
descriptionAppend "To start Flowise: cd $appPath/docker && docker compose up -d"
descriptionAppend "Flowise logs: cd $appPath/docker && docker compose logs -f"
descriptionAppend " "

tagScript success

exit 0
