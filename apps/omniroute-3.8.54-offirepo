#!/bin/bash

# Add this at the beginning of all scripts.
if [ -f "include/startup.sh" ]; then
    . include/startup.sh
elif [ -f "../include/startup.sh" ]; then
    . ../include/startup.sh
fi

rootDir=$(rootDir)

# Bare version, no "v" prefix: npm cannot match "v3.8.54" and would not install the pin.
OMNIROUTE_VERSION="3.8.54"
# OmniRoute declares engines node ">=22.22.2 <23 || >=24.0.0 <27". Ubuntu's own nodejs is
# older than that floor, so Node always comes from NodeSource.
NODE_MAJOR=24
APP_PORT=20128
SERVICE_NAME="omniroute"
UNIT_FILE="/etc/systemd/system/${SERVICE_NAME}.service"
ENV_DIR="/etc/omniroute"
ENV_FILE="${ENV_DIR}/omniroute.env"
dataDir="/root/.omniroute"
NGINX_SITE="/etc/nginx/sites-available/omniroute"
LE_DIR="/etc/letsencrypt/live/${CWM_DOMAIN}"
# Measured on a 1 vCPU / 1 GB RAM / 10 GB disk server: the install takes 2.8 GB in node_modules
# plus a 1.2 GB npm cache while it runs, and peaks near 1.6 GB of RAM and swap together.
MIN_FREE_MB=4500
MIN_INSTALL_MEM_MB=1900
INSTALL_SWAP_FILE="/swapfile-omniroute-install"
NPM_DONE_TAG="omniroute-npm-${OMNIROUTE_VERSION}.success"
# The login page prints this as fixed text, so setting a password does not remove it.
# nginx strips it from the response below.
LOGIN_HINT='Default password: CHANGEME (unless INITIAL_PASSWORD was set)'

export DEBIAN_FRONTEND="noninteractive"

# True when the installed node is inside OmniRoute's supported range.
function nodeVersionOk() {

    local version
    version="$(node --version 2>/dev/null)"
    version="${version#v}"
    [ -n "$version" ] || return 1

    case "${version%%.*}" in
    22) [ "$(printf '%s\n%s\n' "22.22.2" "$version" | sort -V | head -n1)" = "22.22.2" ] ;;
    24 | 25 | 26) return 0 ;;
    *) return 1 ;;
    esac

}

# Quote a value for a systemd EnvironmentFile, so a password holding quotes,
# backslashes or spaces reaches the service unchanged.
function envFileQuote() {

    local value="$1"

    case "$value" in
    *\'*)
        # Inside double quotes systemd unescapes only \ " $ and the backtick.
        printf '"%s"' "$(printf '%s' "$value" | sed 's/[\\"$`]/\\&/g')"
        ;;
    *)
        printf "'%s'" "$value"
        ;;
    esac

}

# Record why an npm attempt failed. npm prints nothing when the kernel kills it, so without
# this the log ends on harmless peer-dependency warnings.
function logNpmFailure() {

    local attempt="$1" exitCode="$2" npmLog

    echo "npm install attempt ${attempt}/3 failed with exit code ${exitCode}" | log
    if [ "$exitCode" -gt 128 ]; then
        echo "npm was killed by signal $((exitCode - 128)); signal 9 usually means the kernel ran out of memory" | log
    fi
    free -m 2>&1 | log
    dmesg 2>/dev/null | grep -i -E 'out of memory|oom-kill|killed process' | tail -n 5 | log
    df -h / 2>&1 | log

    npmLog="$(ls -t /root/.npm/_logs/*-debug-*.log 2>/dev/null | head -n1)"
    if [ -n "$npmLog" ]; then
        echo "Last lines of ${npmLog}:" | log
        tail -n 30 "$npmLog" | log
    fi

}

# RAM plus swap, in MB.
function totalMemoryMb() {

    awk '/^MemTotal:/ {m=$2} /^SwapTotal:/ {s=$2} END {print int((m + s) / 1024)}' /proc/meminfo

}

# Add swap for the duration of the npm install when RAM plus swap is below what it needs.
# tweaks/ubuntu-sysctl-swap covers Ubuntu 22.04/24.04 only, so a small server on another
# release reaches this point with no swap at all.
function addInstallSwap() {

    local sizeMb="$1"

    echo "Adding ${sizeMb} MB of temporary swap for the npm install" | log
    rm -f "${INSTALL_SWAP_FILE}"
    dd if=/dev/zero of="${INSTALL_SWAP_FILE}" bs=1M count="${sizeMb}" status=none &&
        chmod 600 "${INSTALL_SWAP_FILE}" &&
        mkswap "${INSTALL_SWAP_FILE}" >/dev/null &&
        swapon "${INSTALL_SWAP_FILE}"
    if [ $? -ne 0 ]; then
        echo "Could not add temporary swap, continuing without it" | log
        rm -f "${INSTALL_SWAP_FILE}"
    fi

}

function removeInstallSwap() {

    [ -f "${INSTALL_SWAP_FILE}" ] || return 0
    swapoff "${INSTALL_SWAP_FILE}" 2>/dev/null
    rm -f "${INSTALL_SWAP_FILE}"
    echo "Removed temporary swap" | log

}

# Start every npm attempt from nothing. A killed attempt leaves a partial tree behind, and
# installing from a filled npm cache unpacks everything at once: about 3.5 GB of memory
# against 0.7 GB from an empty cache.
function cleanNpmLeftovers() {

    rm -rf "${npmRoot}/omniroute" "${npmRoot}"/.omniroute-*
    # The command links go too: npm leaves a link that already points at the right file alone
    # and then also skips making that file executable.
    rm -f "${npmGlobalBin}/omniroute" "${npmGlobalBin}/omniroute-reset-password"
    npm cache clean --force >/dev/null 2>&1

}

function appHttpCode() {

    curl -s -o /dev/null -m 5 -w '%{http_code}' "http://127.0.0.1:${APP_PORT}$1" 2>/dev/null

}

echo "Checking prerequisites for OmniRoute ${OMNIROUTE_VERSION}" | log

if [ -z "${CWM_DOMAIN}" ]; then
    echo "CWM_DOMAIN is empty, cannot publish OmniRoute over HTTPS. Exiting (1)." | log 1
    exit 1
fi

if [ -z "${ADMINPASSWORD}" ]; then
    echo "ADMINPASSWORD is empty, cannot set the OmniRoute dashboard password. Exiting (1)." | log 1
    exit 1
fi

if [ ! -f "${LE_DIR}/fullchain.pem" ] || [ ! -f "${LE_DIR}/privkey.pem" ]; then
    echo "No certificate found in ${LE_DIR}. Run tweaks/nginx-letsencrypt-cert first. Exiting (1)." | log 1
    exit 1
fi

memoryMb=$(totalMemoryMb)
installSwapMb=0
if [ "$memoryMb" -lt "$MIN_INSTALL_MEM_MB" ]; then
    installSwapMb=$((MIN_INSTALL_MEM_MB - memoryMb + 256))
fi
echo "RAM plus swap: ${memoryMb} MB (the npm install needs about ${MIN_INSTALL_MEM_MB} MB)" | log

echo "Installing dependencies" | log
apt-get update
installPackage curl ca-certificates gnupg openssl
waitOrStop 0 "Failed to install dependencies"

if nodeVersionOk; then

    echo "Node.js $(node --version) already installed and supported, skipping NodeSource setup" | log

else

    echo "Configuring Node.js ${NODE_MAJOR} repository" | log
    # Downloaded to a file first: piping curl into gpg hides a failed download.
    nodesourceKey="${rootDir}/temp/nodesource-repo.gpg.key"
    curlDownload https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key "${nodesourceKey}"

    mkdir -p /etc/apt/keyrings
    gpg --dearmor --yes -o /etc/apt/keyrings/nodesource.gpg "${nodesourceKey}"
    waitOrStop 0 "Failed to install NodeSource signing key"
    chmod 644 /etc/apt/keyrings/nodesource.gpg

    echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_${NODE_MAJOR}.x nodistro main" \
        >/etc/apt/sources.list.d/nodesource.list
    waitOrStop 0 "Failed to configure Node.js ${NODE_MAJOR} repository"

    apt-get update
    waitOrStop 0 "Failed to update apt package index after NodeSource setup"

    echo "Installing Node.js ${NODE_MAJOR}" | log
    installPackage nodejs
    waitOrStop 0 "Failed to install Node.js ${NODE_MAJOR}"

fi

hash -r

node --version | log
waitOrStop 0 "Node.js command is not working"

npm --version | log
waitOrStop 0 "npm command is not working"

nodeVersion="$(node --version 2>/dev/null)"
nodeVersionOk
waitOrStop 0 "Node.js ${nodeVersion} is outside OmniRoute's supported range (>=22.22.2 <23 || >=24.0.0 <27)"

npmRoot="$(npm root -g 2>/dev/null)"
npmPrefix="$(npm prefix -g 2>/dev/null)"
[ -n "$npmRoot" ] && [ -d "$npmRoot" ] && [ -n "$npmPrefix" ]
waitOrStop 0 "Could not find npm's global directories"
# npm's global prefix is not always on PATH, so the command is looked up there as well.
npmGlobalBin="${npmPrefix}/bin"

if [ -f "${rootDir}/temp/${NPM_DONE_TAG}" ]; then

    echo "omniroute@${OMNIROUTE_VERSION} was already installed by an earlier run, skipping npm install" | log

else

    # Checked after the cleanup, so what a failed earlier run left behind is not counted.
    cleanNpmLeftovers
    neededMb=$((MIN_FREE_MB + installSwapMb))
    freeMb=$(df -BM --output=avail / | tail -1 | tr -dc '0-9')
    if [ -z "$freeMb" ] || [ "$freeMb" -lt "$neededMb" ]; then
        df -h / | log
        echo "Only ${freeMb} MB free on /, the OmniRoute install needs ${neededMb} MB. Exiting (1)." | log 1
        exit 1
    fi
    echo "Free disk OK (${freeMb} MB)" | log

    echo "Installing omniroute@${OMNIROUTE_VERSION} from npm (this can take several minutes)" | log

    # onnxruntime-node, a dependency, otherwise downloads its CUDA (GPU) libraries on Linux x64
    # and unzips the archive in memory. That is what the kernel OOM-killed on a 1 GB server.
    export ONNXRUNTIME_NODE_INSTALL=skip

    if [ "$installSwapMb" -gt 0 ]; then
        addInstallSwap "$installSwapMb"
    fi

    npmInstalled=1
    for attempt in 1 2 3; do

        echo "npm install attempt ${attempt}/3" | log
        cleanNpmLeftovers
        npm install -g "omniroute@${OMNIROUTE_VERSION}" --no-audit --no-fund 2>&1 | log
        npmExit="${PIPESTATUS[0]}"
        if [ "$npmExit" -eq 0 ]; then
            npmInstalled=0
            break
        fi
        logNpmFailure "$attempt" "$npmExit"
        sleep 10

    done

    # The cache is about 1.2 GB and is not used again.
    npm cache clean --force >/dev/null 2>&1
    removeInstallSwap

    [ "$npmInstalled" -eq 0 ]
    waitOrStop 0 "Failed to install omniroute@${OMNIROUTE_VERSION} from npm"

fi

hash -r

omnirouteBin="$(command -v omniroute 2>/dev/null)"
if [ ! -x "$omnirouteBin" ]; then
    omnirouteBin="${npmGlobalBin}/omniroute"
fi
if [ ! -x "$omnirouteBin" ]; then
    echo "npm reported success but no omniroute command was found on PATH or in ${npmGlobalBin}. Exiting (1)." | log 1
    exit 1
fi
echo "Using omniroute at ${omnirouteBin}" | log

installedVersion="$(node -p "require('${npmRoot}/omniroute/package.json').version" 2>/dev/null)"
[ "$installedVersion" = "$OMNIROUTE_VERSION" ]
waitOrStop 0 "Installed omniroute version is '${installedVersion}', expected ${OMNIROUTE_VERSION}"
[ -f "${rootDir}/temp/${NPM_DONE_TAG}" ] || tag "${NPM_DONE_TAG}"

echo "Writing OmniRoute secrets file ${ENV_FILE}" | log
# INITIAL_PASSWORD sets the dashboard password on first start. It lives in a 0600 file and not
# in the unit, because the unit is world-readable. The value is never sent to the log here.
mkdir -p "${ENV_DIR}"
(
    umask 077
    printf 'INITIAL_PASSWORD=%s\n' "$(envFileQuote "${ADMINPASSWORD}")" >"${ENV_FILE}"
)
waitOrStop 0 "Failed to write ${ENV_FILE}"
chown root:root "${ENV_FILE}"
chmod 600 "${ENV_FILE}"

echo "Creating OmniRoute systemd service" | log
nodeDir="$(dirname "$(readlink -f "$(command -v node)")")"
unitPath="${nodeDir}"
if [ "${npmGlobalBin}" != "${nodeDir}" ]; then
    unitPath="${unitPath}:${npmGlobalBin}"
fi
unitPath="${unitPath}:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

cat >"${UNIT_FILE}" <<EOF
[Unit]
Description=OmniRoute AI Router
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root

Environment="HOME=/root"
# omniroute is a Node CLI started outside a login shell, so node's directory must be on PATH.
Environment="PATH=${unitPath}"
# Bind to loopback only, nginx is the only way in. HOSTNAME is what the Next.js server reads.
Environment="HOSTNAME=127.0.0.1"
Environment="HOST=127.0.0.1"
Environment="OMNIROUTE_SERVER_HOST=127.0.0.1"
Environment="PORT=${APP_PORT}"
# No anonymous access to /v1, every API call needs a key created in the dashboard.
Environment="REQUIRE_API_KEY=true"
# The dashboard is only served over HTTPS, so session cookies carry the Secure flag.
Environment="AUTH_COOKIE_SECURE=true"
EnvironmentFile=-${ENV_FILE}

ExecStart=${omnirouteBin}

Restart=always
RestartSec=5

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
EOF
waitOrStop 0 "Failed to create ${UNIT_FILE}"

systemctl daemon-reload
waitOrStop 0 "Failed to reload systemd daemon"

systemctl enable "${SERVICE_NAME}"
waitOrStop 0 "Failed to enable ${SERVICE_NAME} service"

echo "Starting OmniRoute service" | log
systemctl restart "${SERVICE_NAME}"
waitOrStop 0 "Failed to start ${SERVICE_NAME} service"

echo "Waiting for OmniRoute to answer on 127.0.0.1:${APP_PORT}" | log
appUp=1
for attempt in $(seq 1 40); do

    httpCode="$(appHttpCode /)"
    if [ -n "$httpCode" ] && [ "$httpCode" != "000" ]; then
        appUp=0
        break
    fi
    sleep 3

done
if [ "$appUp" -ne 0 ]; then
    journalctl -u "${SERVICE_NAME}" -n 40 --no-pager 2>&1 | log
    echo "OmniRoute did not answer on 127.0.0.1:${APP_PORT}. See journalctl -u ${SERVICE_NAME}. Exiting (1)." | log 1
    exit 1
fi
echo "OmniRoute answers on 127.0.0.1:${APP_PORT} (HTTP ${httpCode})" | log

# Restart=always keeps a crash-looping unit "active", so compare the restart counter
# across more than one RestartSec.
restartsBefore="$(systemctl show "${SERVICE_NAME}" -p NRestarts --value 2>/dev/null)"
sleep 8
restartsAfter="$(systemctl show "${SERVICE_NAME}" -p NRestarts --value 2>/dev/null)"
if ! systemctl is-active --quiet "${SERVICE_NAME}" || [ "$restartsBefore" != "$restartsAfter" ]; then
    journalctl -u "${SERVICE_NAME}" -n 40 --no-pager 2>&1 | log
    echo "OmniRoute service is not stable (restarts: ${restartsBefore} -> ${restartsAfter}). Exiting (1)." | log 1
    exit 1
fi

echo "Configuring Nginx for OmniRoute (HTTPS)" | log
# nginx and the certificate are provided by tweaks/nginx-letsencrypt-cert (run earlier in
# the contrib). "listen ... http2" is deprecated from nginx 1.25.1, which has "http2 on;".
nginxVersion="$(nginx -v 2>&1 | sed 's/.*nginx\///; s/ .*//')"
if [ "$(printf '%s\n%s\n' "1.25.1" "$nginxVersion" | sort -V | head -n1)" = "1.25.1" ]; then
    listenHttp2=""
    http2Directive="http2 on;"
else
    listenHttp2=" http2"
    http2Directive=""
fi

cat >"${NGINX_SITE}" <<EOF
map \$http_upgrade \$omniroute_connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    listen [::]:80;
    server_name ${CWM_DOMAIN};
    return 301 https://\$host\$request_uri;
}

server {
    listen 443 ssl${listenHttp2};
    listen [::]:443 ssl${listenHttp2};
    ${http2Directive}
    server_name ${CWM_DOMAIN};

    ssl_certificate     ${LE_DIR}/fullchain.pem;
    ssl_certificate_key ${LE_DIR}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache shared:OmniRouteTLS:10m;

    # Uploads are prompts, downloads are token streams.
    client_max_body_size 64m;

    # The dashboard, /v1 and /api/mcp/* are one process on one port.
    location / {
        proxy_pass http://127.0.0.1:${APP_PORT};
        proxy_http_version 1.1;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection \$omniroute_connection_upgrade;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host \$host;
        proxy_set_header X-Forwarded-Port 443;

        # SSE and streamed completions stall behind a buffer, and a model answer can
        # take longer than the 60s default.
        proxy_buffering off;
        gzip off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;

        # Remove the login page's fixed default-password hint. The upstream response must
        # be uncompressed for sub_filter to see it. text/html is always filtered,
        # text/x-component covers Next.js RSC payloads.
        proxy_set_header Accept-Encoding "";
        sub_filter_types text/x-component;
        sub_filter '${LOGIN_HINT}' '';
        sub_filter_once off;

        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
    }
}
EOF
waitOrStop 0 "Failed to create Nginx configuration for OmniRoute"

ln -sf "${NGINX_SITE}" /etc/nginx/sites-enabled/omniroute
waitOrStop 0 "Failed to enable OmniRoute Nginx site"
rm -f /etc/nginx/sites-enabled/default

nginx -t 2>&1 | log
waitOrStop 0 "Nginx configuration test failed"

systemctl enable nginx
systemctl restart nginx
waitOrStop 0 "Failed to restart Nginx"

echo "Checking OmniRoute through Nginx on https://${CWM_DOMAIN}/" | log
siteUp=1
for attempt in $(seq 1 10); do

    siteCode="$(curl -sk -o /dev/null -m 10 -w '%{http_code}' --resolve "${CWM_DOMAIN}:443:127.0.0.1" "https://${CWM_DOMAIN}/" 2>/dev/null)"
    case "$siteCode" in
    2* | 3*)
        siteUp=0
        break
        ;;
    esac
    sleep 3

done
if [ "$siteUp" -ne 0 ]; then
    tail -n 10 /var/log/nginx/error.log 2>&1 | log
    echo "OmniRoute is not reachable through Nginx (HTTP ${siteCode}). Exiting (1)." | log 1
    exit 1
fi
echo "OmniRoute is reachable through Nginx (HTTP ${siteCode})" | log

# Not fatal: ufw never opens ${APP_PORT}, and a dashboard setting can override REQUIRE_API_KEY.
apiCode="$(appHttpCode /v1/models)"
if [ "$apiCode" = "401" ]; then
    echo "Anonymous /v1 access is refused (HTTP 401), API is key-only" | log
else
    echo "WARNING: anonymous /v1/models returned HTTP ${apiCode}, expected 401. Check REQUIRE_API_KEY." | log
fi

listenAddrs="$(ss -lntH "sport = :${APP_PORT}" 2>/dev/null | awk '{print $4}')"
if [ -z "$listenAddrs" ]; then
    echo "WARNING: could not read the listener on port ${APP_PORT} with ss, bind address not checked" | log
elif echo "$listenAddrs" | grep -qvE '^(127\.0\.0\.1|\[::1\]):'; then
    echo "WARNING: OmniRoute is not loopback-only, it listens on: $(echo $listenAddrs). Port ${APP_PORT} stays closed in ufw." | log
else
    echo "OmniRoute listens on loopback only" | log
fi

echo "Adding descriptions" | log
descriptionAppend "OmniRoute AI Router ${OMNIROUTE_VERSION} is installed and running."
descriptionAppend " "
descriptionAppend "OmniRoute Dashboard: https://${CWM_DOMAIN}/"
descriptionAppend "OmniRoute Password: ${ADMINPASSWORD}"
descriptionAppend " "
descriptionAppend "OmniRoute API base URL (OpenAI-compatible): https://${CWM_DOMAIN}/v1"
descriptionAppend "API access is key-only: create a key in the dashboard and send it as 'Authorization: Bearer <key>'"
descriptionAppend " "
descriptionAppend "OmniRoute service status: systemctl status ${SERVICE_NAME}"
descriptionAppend "OmniRoute service restart: systemctl restart ${SERVICE_NAME}"
descriptionAppend "OmniRoute logs: journalctl -u ${SERVICE_NAME} -f"
descriptionAppend "OmniRoute data directory: ${dataDir}"
descriptionAppend "OmniRoute systemd unit: ${UNIT_FILE}"
descriptionAppend "OmniRoute Nginx config file: ${NGINX_SITE}"
descriptionAppend "OmniRoute local address (behind Nginx): http://127.0.0.1:${APP_PORT}"
descriptionAppend "Reset the dashboard password: omniroute reset-password, then systemctl restart ${SERVICE_NAME}"
descriptionAppend " "

tagScript success

exit 0
