#!/bin/bash
if [ -f "include/startup.sh" ]; then
    . include/startup.sh
elif [ -f "../include/startup.sh" ]; then
    . ../include/startup.sh
fi


version="10.1.9"

echo "Installing Storybook with React + Vite + Nginx + SSL" | log

export DEBIAN_FRONTEND="noninteractive"

# Install system dependencies
echo "Installing system dependencies..." | log
apt update 2>&1 | log
apt install -y curl git ca-certificates 2>&1 | log
waitOrStop 0 "Failed to install system dependencies (curl/git/ca-certificates)"
update-ca-certificates 2>&1 | log

# Install Node.js 20
echo "Installing Node.js 20..." | log
curl -fsSL https://deb.nodesource.com/setup_20.x 2>&1 | bash - 2>&1 | log
apt install -y nodejs 2>&1 | log
waitOrStop 0 "Failed to install Node.js 20"

appInstallDir="/opt/storybook-app"
mkdir -p "${appInstallDir}"
cd "${appInstallDir}"

echo "Creating React + Vite project..." | log
npx -y create-vite@latest . --template react-ts --no-interactive 2>&1 | log
waitOrStop 0 "Failed to scaffold the React + Vite project"

echo "Installing project dependencies..." | log
npm install 2>&1 | log
waitOrStop 0 "npm install of project dependencies failed"

echo "Installing Storybook..." | log
CI=true npx storybook@${version} init --yes --skip-install --no-dev 2>&1 | log

# create-vite@latest scaffolds vite 8 + @vitejs/plugin-react 6, both newer than
# @storybook/react-vite ${version} supports (peer: vite ^5||^6||^7). Pin them to the
# compatible major before installing, else `npm install` aborts with ERESOLVE, the
# storybook binary is never installed, and the build below fails with "storybook: not found".
npm pkg set devDependencies.vite='^7.0.0' 2>&1 | log
npm pkg set 'devDependencies.@vitejs/plugin-react'='^5.0.0' 2>&1 | log

echo "Installing Storybook dependencies..." | log
npm install 2>&1 | log
waitOrStop 0 "npm install of Storybook dependencies failed"

echo "Building Storybook for production..." | log
npm run build-storybook 2>&1 | log
waitOrStop 0 "Storybook build failed"

if [ ! -d "${appInstallDir}/storybook-static" ]; then
    echo "❌ Storybook build failed: storybook-static directory not found" | log
    exit 1
fi

echo "Configuring Nginx..." | log
cat > /etc/nginx/sites-available/storybook << NGINXCONF
server {
    listen 80;
    server_name ${CWM_DOMAIN};
    return 301 https://\$server_name\$request_uri;
}

server {
    listen 443 ssl http2;
    server_name ${CWM_DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${CWM_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${CWM_DOMAIN}/privkey.pem;

    root ${appInstallDir}/storybook-static;
    index index.html;

    location / {
        try_files \$uri \$uri/ /index.html;
    }

    # Cache static assets aggressively
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)\$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
NGINXCONF

ln -sf /etc/nginx/sites-available/storybook /etc/nginx/sites-enabled/
rm -f /etc/nginx/sites-enabled/default

systemctl restart nginx
waitOrStop 0 "Failed to restart Nginx"

echo "Adding descriptions" | log
descriptionAppend "Storybook is LIVE!"
descriptionAppend "URL: https://${CWM_DOMAIN}"
descriptionAppend " "
descriptionAppend "Framework: React + Vite + TypeScript"
descriptionAppend "Project Location: ${appInstallDir}"
descriptionAppend "Static Build: ${appInstallDir}/storybook-static"
descriptionAppend " "
descriptionAppend "To rebuild after changes:"
descriptionAppend " cd ${appInstallDir}"
descriptionAppend " npm run build-storybook"

tagScript success
exit 0
