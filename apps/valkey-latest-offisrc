#!/bin/bash

if [ -f "include/startup.sh" ]; then
    . include/startup.sh
elif [ -f "../include/startup.sh" ]; then
    . ../include/startup.sh
fi

set_motd() {
	cat <<'EOF' >/etc/motd
============================================================
 Valkey Server Installed
============================================================
Service:   systemctl status valkey
Start:     systemctl start valkey
Stop:      systemctl stop valkey
Config:    /etc/valkey/valkey.conf
CLI usage: valkey-cli PING
Data dir:  /var/lib/valkey

============================================================
EOF
}

apt update
apt install -y valkey valkey-redis-compat

if [ "$(valkey-cli ping 2>/dev/null)" = "PONG" ]; then
    sed -i 's/^appendonly[[:space:]]\+no$/appendonly yes/' /etc/valkey/valkey.conf
    sed -i '/^# *save 3600 1 300 100 60 10000$/s/^# *//' /etc/valkey/valkey.conf
	
	systemctl restart valkey
fi

set_motd

VALKEY_PORT=6379
VALKEY_VERSION=$(valkey-server --version | grep -oP 'v=\K[0-9.]+')

# Static landing page. Valkey is a datastore with no HTTP UI of its own, and this
# install binds it to localhost only (no password) — so this page is purely
# informational: anyone who hits the host in a browser learns it's a local-only
# datastore instead of getting a refused connection. nginx + cert come from
# tweaks/nginx-letsencrypt-cert in the contrib.
echo "Writing Valkey landing page" | log
mkdir -p /var/www/valkey
cat << 'EOF' > /var/www/valkey/index.html
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Valkey Server — __DOMAIN__</title>
<style>
  body { font-family: 'Helvetica Neue', Arial, sans-serif; margin: 0; padding: 40px 20px; background: #121212; color: #E0E0E0; min-height: 100vh; }
  .card { max-width: 640px; margin: 0 auto; background: #1E1E1E; border-radius: 12px; padding: 32px; box-shadow: 0 8px 24px rgba(0,0,0,0.4); }
  h1 { margin: 0 0 8px; color: #ff4438; font-size: 28px; }
  .sub { color: #888; margin-bottom: 24px; }
  .row { background: #000; border: 1px solid #ff4438; border-radius: 6px; padding: 14px 16px; margin: 10px 0; font-family: 'Courier New', monospace; display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .label { color: #888; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px; }
  .value { color: #ff8077; font-size: 16px; word-break: break-all; }
  .copy { background: #ff4438; color: #fff; border: none; padding: 6px 12px; border-radius: 4px; cursor: pointer; font-size: 12px; }
  .copy:hover { background: #ff5b50; }
  .note { color: #888; font-size: 13px; margin-top: 24px; line-height: 1.5; }
</style>
</head>
<body>
  <div class="card">
    <h1>Valkey Datastore</h1>
    <div class="sub">Redis-compatible in-memory datastore (v__VERSION__). There is no web UI.</div>

    <div class="row">
      <div>
        <div class="label">Bind address</div>
        <div class="value">127.0.0.1:__PORT__ &nbsp;(localhost only)</div>
      </div>
    </div>

    <div class="row">
      <div>
        <div class="label">Connect on the server</div>
        <div class="value" id="cli">valkey-cli</div>
      </div>
      <button class="copy" onclick="navigator.clipboard.writeText(document.getElementById('cli').innerText)">Copy</button>
    </div>

    <div class="row">
      <div>
        <div class="label">Health check</div>
        <div class="value">valkey-cli PING  →  PONG</div>
      </div>
    </div>

    <div class="note">
      This datastore is <strong>not exposed to the network</strong> — it listens on
      <code>127.0.0.1:__PORT__</code> only and <strong>no auth password is set</strong>, so it is
      reachable solely from this server. Connect by SSHing in and running <code>valkey-cli</code>.<br><br>
      Config: <code>/etc/valkey/valkey.conf</code> &nbsp;·&nbsp; Data: <code>/var/lib/valkey</code><br>
      Service: <code>systemctl status valkey</code>
    </div>
  </div>
</body>
</html>
EOF
sed -i "s|__DOMAIN__|${CWM_DOMAIN}|g; s|__VERSION__|${VALKEY_VERSION}|g; s|__PORT__|${VALKEY_PORT}|g" /var/www/valkey/index.html

echo "Writing nginx vhost for Valkey landing page" | log
cat << EOF > /etc/nginx/sites-available/valkey
server {
    listen 80;
    server_name ${CWM_DOMAIN};
    return 301 https://\$server_name\$request_uri;
}
server {
    listen 443 ssl http2;
    server_name ${CWM_DOMAIN};
    ssl_certificate     /etc/letsencrypt/live/${CWM_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${CWM_DOMAIN}/privkey.pem;

    root /var/www/valkey;
    index index.html;

    location / {
        try_files \$uri \$uri/ =404;
    }
}
EOF
ln -sf /etc/nginx/sites-available/valkey /etc/nginx/sites-enabled/valkey
rm -f /etc/nginx/sites-enabled/default
nginx -t 2>&1 | log
systemctl enable nginx
systemctl restart nginx
waitOrStop 0 "Failed to restart nginx for Valkey landing page"

echo "Adding descriptions" | log
descriptionAppend "Valkey in-memory datastore (Redis-compatible) v${VALKEY_VERSION} installed."
descriptionAppend "Web info page: https://${CWM_DOMAIN}/"
descriptionAppend "Bound to localhost only (127.0.0.1:${VALKEY_PORT}) — not exposed to the network."
descriptionAppend "No auth password set (local access only)."
descriptionAppend "Connect on this server: valkey-cli  (test: valkey-cli PING)"
descriptionAppend "Config: /etc/valkey/valkey.conf | Data: /var/lib/valkey"

tagScript success

exit 0
