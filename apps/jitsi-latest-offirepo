#!/bin/bash

if [ -f "include/startup.sh" ]; then
    . include/startup.sh
elif [ -f "../include/startup.sh" ]; then
    . ../include/startup.sh
fi

echo "Setting HostName" | log
hostnamectl set-hostname jitsi.${CWM_DOMAIN}

echo "Adding FW rules" | log
ufw allow 10000
ufw allow 3478
ufw allow 5349

echo "Downloading Jitsi and adding key" | log
apt update | log
installPackage apt-transport-https
waitOrStop 0 "Failed to install apt-transport-https"
# Modern keyring (signed-by) instead of the deprecated apt-key, which is removed on Ubuntu 24.04+.
mkdir -p /etc/apt/keyrings
curl -fsSL https://download.jitsi.org/jitsi-key.gpg.key | gpg --dearmor -o /etc/apt/keyrings/jitsi.gpg
waitOrStop 0 "Jitsi signing key not downloaded from official source"
echo "deb [signed-by=/etc/apt/keyrings/jitsi.gpg] https://download.jitsi.org stable/" > /etc/apt/sources.list.d/jitsi-stable.list
apt update | log

# jitsi-meet-prosody needs prosody >= 0.12, but Ubuntu 22.04 universe only has 0.11.13, which makes
# the whole jitsi-meet apt transaction fail with "held broken packages". On those releases add the
# official Prosody repo and pin the 0.12 LTS series explicitly. We deliberately install prosody-0.12
# and NOT the generic "prosody" (now 13.x): prosody 13 dropped Lua 5.1 support, and on 22.04 (whose
# default lua is 5.1) that makes the jitsi-meet-prosody post-install fail, leaving the meeting backend
# broken even though the web UI loads. Installing prosody-0.12 first also satisfies jitsi-meet-prosody's
# "| prosody-0.12 |" dependency alternative, so apt never pulls 13.x. 24.04/26.04 already ship
# prosody >= 0.12 built for a supported Lua, so they keep the OS package and skip this block.
echo "Ensuring prosody >= 0.12 (jitsi-meet-prosody requirement)" | log
prosodyCand=$(apt-cache policy prosody 2>/dev/null | awk '/Candidate:/{print $2}')
if ! dpkg --compare-versions "$prosodyCand" ge 0.12.0; then
    echo "OS prosody ($prosodyCand) too old; adding official Prosody repo and pinning prosody-0.12" | log
    curl -fsSL https://prosody.im/files/prosody-debian-packages.key | gpg --dearmor -o /etc/apt/keyrings/prosody.gpg
    waitOrStop 0 "Prosody signing key not downloaded from official source"
    echo "deb [signed-by=/etc/apt/keyrings/prosody.gpg] https://packages.prosody.im/debian $(lsb_release -sc) main" > /etc/apt/sources.list.d/prosody.list
    apt update | log
    installPackage prosody-0.12 | log
    waitOrStop 0 "Failed to install prosody-0.12"
fi

echo "Installing Jitsi" | log
export DEBIAN_FRONTEND="noninteractive"
echo "jitsi-videobridge jitsi-videobridge/jvb-hostname string jitsi.${CWM_DOMAIN}" | debconf-set-selections
echo "jitsi-meet jitsi-meet/cert-choice select Self-signed certificate will be generated" | debconf-set-selections
installPackage jitsi-meet | log
waitOrStop 0 "Failed to install jitsi-meet"
# Reload nginx only if the config tests clean, so a bad vhost can never take nginx down.
reloadNginx() {
    nginx -t 2>&1 | log
    if [ ${PIPESTATUS[0]} -eq 0 ]; then
        systemctl reload nginx 2>&1 | log
    else
        echo "nginx config test failed; skipping reload" | log 1
    fi
}

# jitsi-meet ships a self-signed cert at /etc/jitsi/meet/jitsi.${CWM_DOMAIN}.{crt,key}
# (debconf "Self-signed certificate ..." above) and its vhost already points at those paths.
# We obtain ONE trusted SAN cert covering both jitsi.${CWM_DOMAIN} and ${CWM_DOMAIN} and
# install it OVER those same files. On any failure the self-signed cert simply stays in
# place, so HTTPS keeps working and we never lock anyone out.
CERT=/etc/jitsi/meet/jitsi.${CWM_DOMAIN}

# Redirect vhost (port 80): serves the ACME http-01 challenge for the bare domain from
# Jitsi's webroot and redirects plain HTTP to the Jitsi subdomain. No cert needed -> safe.
echo "Configuring ${CWM_DOMAIN} -> https://jitsi.${CWM_DOMAIN} redirect" | log
cat << EOF > /etc/nginx/sites-available/jitsi-redirect
server {
    listen 80;
    listen [::]:80;
    server_name ${CWM_DOMAIN};

    location ^~ /.well-known/acme-challenge/ {
        default_type "text/plain";
        root /usr/share/jitsi-meet;
    }
    location / {
        return 301 https://jitsi.${CWM_DOMAIN}\$request_uri;
    }
}
EOF
ln -sf /etc/nginx/sites-available/jitsi-redirect /etc/nginx/sites-enabled/jitsi-redirect
reloadNginx

# This Jitsi build uses acme.sh (NOT certbot) for Let's Encrypt. Bootstrap it if the vendor
# install path is not already present, then issue a SAN cert for both names in one shot.
export HOME=/opt/acmesh
ACME=/opt/acmesh/.acme.sh/acme.sh
if [ ! -x "$ACME" ]; then
    echo "Bootstrapping acme.sh" | log
    curl https://get.acme.sh | sh -s email=${ADMINEMAIL} 2>&1 | log
fi

echo "Issuing Let's Encrypt SAN cert for jitsi.${CWM_DOMAIN} + ${CWM_DOMAIN}" | log
acmeOk=1
if [ -x "$ACME" ]; then
    n=0
    until [ $n -ge 5 ]; do
        "$ACME" -f --issue -d jitsi.${CWM_DOMAIN} -d ${CWM_DOMAIN} -w /usr/share/jitsi-meet --server letsencrypt > /tmp/acme-issue.out 2>&1
        acmeRc=$?
        cat /tmp/acme-issue.out | log
        if [ $acmeRc -eq 0 ]; then acmeOk=0; break; fi
        n=$((n + 1))
        echo "acme.sh issue attempt $n failed (rate limit / DNS not ready); retrying in 30s" | log 1
        sleep 30
    done
fi

if [ $acmeOk -eq 0 ]; then
    # Install the trusted cert over the jitsi self-signed paths and refresh nginx + coturn.
    "$ACME" -f --install-cert -d jitsi.${CWM_DOMAIN} \
        --key-file ${CERT}.key --fullchain-file ${CERT}.crt \
        --reloadcmd "systemctl force-reload nginx.service && /usr/share/jitsi-meet/scripts/coturn-le-update.sh jitsi.${CWM_DOMAIN}" 2>&1 | log
else
    echo "Let's Encrypt issuance failed; keeping self-signed cert for jitsi.${CWM_DOMAIN}" | log 1
fi

# Redirect vhost (port 443): redirect HTTPS on the bare domain to the Jitsi subdomain.
# Reuses the jitsi cert files (always present), so this can never reference a missing cert.
cat << EOF >> /etc/nginx/sites-available/jitsi-redirect

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ${CWM_DOMAIN};

    ssl_certificate     ${CERT}.crt;
    ssl_certificate_key ${CERT}.key;

    return 301 https://jitsi.${CWM_DOMAIN}\$request_uri;
}
EOF
reloadNginx

echo "Adding descriptions" | log
descriptionAppend "Jitsi Web UI: https://jitsi.${CWM_DOMAIN} (https://${CWM_DOMAIN} redirects here)"
descriptionAppend " "

tagScript success

exit 0