#!/bin/bash

if [ -f "include/startup.sh" ]; then
    . include/startup.sh
elif [ -f "../include/startup.sh" ]; then
    . ../include/startup.sh
fi

checkTagExist php.success
checkTagExist nginx.success
checkTagExist mysqld.success

appPath=/var/www/
rootDir=$(rootDir)

echo "Downloading Matomo" | log
curlDownload https://builds.matomo.org/matomo-latest.zip
waitOrStop 0 "File not downloaded from official source"

echo "Extracting Matomo" | log
installPackage unzip | log
mkdir -p $appPath
unzip matomo-latest.zip -d $appPath
waitOrStop 0 "Failed to extract"

echo "Setting permissions" | log
chown www-data:www-data /var/www/matomo/ -R

echo "Creating Matomo Database" | log
mysql --defaults-file=/root/.my.cnf -h localhost <<EOF
CREATE DATABASE matomo CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci;
CREATE USER 'matomouser'@'localhost' identified with mysql_native_password by '${ADMINPASSWORD}';
GRANT all privileges on matomo.* to matomouser@localhost;
FLUSH PRIVILEGES;
EOF

echo "Creating VirtualHost" | log
cp $rootDir/tweaks/extras/matomo/matomo.conf /etc/nginx/conf.d/
sed -i "s/ServerDomain/${CWM_DISPLAYED_ADDRESS}/g" /etc/nginx/conf.d/matomo.conf
# matomo.conf passes FastCGI over unix:/run/php/php-fpm.sock, while
# tweaks/nginx-enable-php has already pointed the pool at 127.0.0.1:9000, so the
# pool has to be moved back to that socket. Matched by pattern and keyed off the
# installed PHP version instead of '36d'/'35 a' against a hardcoded 7.4 path: a
# line-numbered edit deletes whatever happens to sit on line 36 of the distro's
# www.conf, and both break outright on any other PHP version.
phpVersion=$(php -v | head -n 1 | cut -d " " -f 2 | cut -f1-2 -d".")
sed -i "s|^listen = .*|listen = /run/php/php-fpm.sock|" /etc/php/${phpVersion}/fpm/pool.d/www.conf
unlink /etc/nginx/sites-enabled/default
unlink /etc/nginx/sites-enabled/default-ssl
systemctl restart php${phpVersion}-fpm
waitOrStop 0 "Restart php${phpVersion}-fpm service failed"
systemctl restart nginx
waitOrStop 0 "Restart nginx service failed"

echo "Seeding Matomo trusted hosts" | log
# Matomo stores whichever host finished the web installer in trusted_hosts[], and
# nothing here seeded it -- so a setup completed over the IP left nginx's
# server_name and Matomo's trusted host disagreeing. Matomo then serves its "not
# configured for this host" page, and that page's own remedy text tells the admin
# to set enable_trusted_host_check=0 (core/Plugin/Controller.php), which is how
# the check ends up disabled in the field. Seeding both names before first run
# removes the trigger and leaves the check at its global.ini.php default of 1.
# A config.ini.php holding only [General] does not read as "already installed":
# the web installer still runs, it just inherits these hosts.
matomoConf=/var/www/matomo/config/config.ini.php
serverIp=${CWM_SERVERIP:-$(hostname -I | awk '{print $1}')}
if [ -f "$matomoConf" ]; then
    echo "Matomo config.ini.php already exists; leaving trusted_hosts untouched" | log
else
    # The guard line is what Matomo itself puts at the top of this file: should
    # the config directory ever become web-readable, PHP exits instead of serving
    # the settings as text. Matomo adds it on first access anyway -- writing it
    # here means the file is never on disk without it.
    cat > "$matomoConf" <<EOF
; <?php exit; ?> DO NOT REMOVE THIS LINE
[General]
trusted_hosts[] = "${CWM_DISPLAYED_ADDRESS}"
trusted_hosts[] = "${serverIp}"
EOF
    chown www-data:www-data "$matomoConf"
    chmod 640 "$matomoConf"
fi

echo "Adding descriptions" | log
descriptionAppend "Database = matomo | DBUser = matomouser"
descriptionAppend "To finalize the installation visit the Web UI"
descriptionAppend "Matomo Admin Web UI: https://${CWM_DISPLAYED_ADDRESS}"
descriptionAppend " "

tagScript success

exit 0
