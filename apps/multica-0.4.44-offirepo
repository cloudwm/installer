#!/bin/bash
# Add this at the beginning of all scripts.
if [ -f "include/startup.sh" ]; then
    . include/startup.sh
elif [ -f "../include/startup.sh" ]; then
    . ../include/startup.sh
fi

rootDir=$(rootDir)
version="v0.4.44"

echo "Installing Multica (self-hosted) with Docker Compose, Nginx + Let's Encrypt" | log

export DEBIAN_FRONTEND="noninteractive"

apt-get update
installPackage curl git ca-certificates gnupg lsb-release apt-transport-https \
               openssl jq ufw

if ! command -v docker &> /dev/null; then
    echo "Installing Docker" | log
    install -m 0755 -d /etc/apt/keyrings
    curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg
    chmod a+r /etc/apt/keyrings/docker.gpg
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu $(lsb_release -cs) stable" | tee /etc/apt/sources.list.d/docker.list > /dev/null
    apt-get update
    installPackage docker-ce docker-ce-cli containerd.io docker-compose-plugin
fi

systemctl enable docker
systemctl start docker
waitOrStop 0 "Docker service failed to start"

APP_DIR="/opt/multica"
mkdir -p "$APP_DIR"
cd "$APP_DIR"
waitOrStop 0 "Cannot cd to $APP_DIR"

echo "Downloading Multica self-host compose file (${version})" | log
curlDownload "https://raw.githubusercontent.com/multica-ai/multica/${version}/docker-compose.selfhost.yml" "${APP_DIR}/docker-compose.selfhost.yml"

# Secrets. JWT_SECRET is mandatory - docker compose refuses to start without it
# and a production backend refuses to boot on the dev default.
JWT_SECRET=$(openssl rand -hex 32)
POSTGRES_PASSWORD=$(openssl rand -hex 16)
VCS_SECRET_KEY=$(openssl rand -hex 32)

# Multica has no password login at all - authentication is a 6-digit code. With
# no mail provider configured the backend prints the code to its own log instead
# of sending it, so logins never involve email. Only this address is allowed to
# hold an account.
ADMIN_EMAIL="${ADMINEMAIL:-admin@${CWM_DOMAIN}}"

echo "Creating .env file" | log
cat << EOF > "${APP_DIR}/.env"
# Multica self-host configuration - generated by the installer
MULTICA_IMAGE_TAG=${version}

# Database
POSTGRES_DB=multica
POSTGRES_USER=multica
POSTGRES_PASSWORD=${POSTGRES_PASSWORD}

# Server
APP_ENV=production
PORT=8080
FRONTEND_PORT=3000
JWT_SECRET=${JWT_SECRET}

# Same-origin layout: Nginx serves the frontend and the /ws upgrade on one
# vhost, Next.js rewrites forward /v1, /api, /auth and /uploads to the backend.
FRONTEND_ORIGIN=https://${CWM_DOMAIN}
CORS_ALLOWED_ORIGINS=https://${CWM_DOMAIN}
COOKIE_DOMAIN=
MULTICA_APP_URL=https://${CWM_DOMAIN}
MULTICA_PUBLIC_URL=https://${CWM_DOMAIN}
MULTICA_DAEMON_SERVER_URL=https://${CWM_DOMAIN}
GOOGLE_REDIRECT_URI=https://${CWM_DOMAIN}/auth/callback
REMOTE_API_URL=http://backend:8080
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=

# Nginx runs on the same host, so the webhook rate limiter may trust its headers
MULTICA_TRUSTED_PROXIES=127.0.0.1/32

# Self-hosted Git provider integration (Forgejo / Gitea / GitLab)
MULTICA_VCS_INTEGRATION_ENABLED=true
MULTICA_VCS_SECRET_KEY=${VCS_SECRET_KEY}

# Only this address may ever hold an account. An explicit allowlist entry wins
# over ALLOW_SIGNUP, so the admin can still be created while every other address
# is refused at /auth/send-code - that is what stops the fixed login code from
# working for anyone who simply types a different email.
ALLOW_SIGNUP=false
ALLOWED_EMAILS=${ADMIN_EMAIL}

# Set RESEND_API_KEY to deliver login codes by email. Left empty, the code is
# printed to the backend container logs instead.
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@${CWM_DOMAIN}
EOF

chmod 600 "${APP_DIR}/.env"

echo "Pulling Multica images from GHCR" | log
docker compose -f docker-compose.selfhost.yml pull
waitOrStop 0 "Failed to pull Multica images"

echo "Starting Multica services" | log
docker compose -f docker-compose.selfhost.yml up -d
waitOrStop 0 "Failed to start Multica services"

echo "Waiting for the backend to run migrations and become healthy" | log
backendUp=1
for attempt in $(seq 1 60); do
    if curl -fsS http://127.0.0.1:8080/health > /dev/null 2>&1; then
        backendUp=0
        break
    fi
    sleep 5
done

if [ $backendUp -ne 0 ]; then
    docker compose -f docker-compose.selfhost.yml logs --tail 50 backend | log 1
    echo "Multica backend did not become healthy in time. exiting (1)." | log 1
    exit 1
fi
echo "Multica backend is healthy" | log

echo "Waiting for the frontend to accept connections" | log
frontendUp=1
for attempt in $(seq 1 30); do
    if curl -fsS http://127.0.0.1:3000 > /dev/null 2>&1; then
        frontendUp=0
        break
    fi
    sleep 5
done

if [ $frontendUp -ne 0 ]; then
    docker compose -f docker-compose.selfhost.yml logs --tail 50 frontend | log 1
    echo "Multica frontend did not start in time. exiting (1)." | log 1
    exit 1
fi
echo "Multica frontend is up" | log

echo "Creating the admin account and its workspace" | log
apiUrl="http://127.0.0.1:8080"
bootstrapOk=0

# No mail provider is configured, so the backend prints the code to its log
# rather than emailing it. Ask for one, then read it back.
curl -fsS -X POST "${apiUrl}/auth/send-code" \
    -H "Content-Type: application/json" \
    -d "{\"email\":\"${ADMIN_EMAIL}\"}" > /dev/null 2>&1

loginCode=""
for attempt in $(seq 1 15); do
    loginCode=$(docker compose -f docker-compose.selfhost.yml logs backend 2>/dev/null \
        | grep -F "[DEV] Verification code for ${ADMIN_EMAIL}:" \
        | tail -n1 | awk '{print $NF}' | tr -d '\r')
    if [ -n "$loginCode" ]; then
        break
    fi
    sleep 2
done

loginToken=""
if [ -n "$loginCode" ]; then
    loginToken=$(curl -fsS -X POST "${apiUrl}/auth/verify-code" \
        -H "Content-Type: application/json" \
        -d "{\"email\":\"${ADMIN_EMAIL}\",\"code\":\"${loginCode}\"}" 2>/dev/null | jq -r '.token // empty')
fi

if [ -n "$loginToken" ]; then

    workspaceId=$(curl -fsS -X POST "${apiUrl}/api/workspaces" \
        -H "Content-Type: application/json" \
        -H "Authorization: Bearer ${loginToken}" \
        -d '{"name":"My Workspace","slug":"my-workspace"}' 2>/dev/null | jq -r '.id // empty')

    # onboarded_at is owned by this endpoint, not by workspace creation. Without
    # it the app sends the user back to /onboarding on every visit.
    curl -fsS -X POST "${apiUrl}/api/me/onboarding/complete" \
        -H "Content-Type: application/json" \
        -H "Authorization: Bearer ${loginToken}" \
        -d "{\"completion_path\":\"skip_existing\",\"workspace_id\":\"${workspaceId}\"}" > /dev/null 2>&1

    if [ -n "$workspaceId" ]; then
        bootstrapOk=1
        echo "Admin account and workspace created, onboarding marked complete" | log
    fi
fi

if [ $bootstrapOk -ne 1 ]; then
    echo "Could not pre-create the admin account. Multica is installed and running, but the Get Started screen will appear on first login." | log
fi

echo "Installing the multica-login-code helper" | log
cat << 'HELPEOF' > /usr/local/bin/multica-login-code
#!/bin/bash
# Prints a fresh Multica login code. No email is involved: with no mail provider
# configured the backend writes the code to its own container log, and this just
# requests one and reads it back.
#
# Usage: multica-login-code [email]

APP_DIR="/opt/multica"
COMPOSE="docker compose -f ${APP_DIR}/docker-compose.selfhost.yml"
EMAIL="${1:-MULTICA_ADMIN_EMAIL}"
MARKER="[DEV] Verification code for ${EMAIL}:"

cd "$APP_DIR" || { echo "Cannot cd to $APP_DIR" >&2; exit 1; }

# Count the codes already in the log so we return the NEW one, not the last one.
before=$($COMPOSE logs backend 2>/dev/null | grep -cF "$MARKER")

if ! curl -fsS -X POST http://127.0.0.1:8080/auth/send-code \
    -H "Content-Type: application/json" \
    -d "{\"email\":\"${EMAIL}\"}" > /dev/null; then
    echo "Failed to request a code. Multica allows one code per 60s per address - wait and retry." >&2
    exit 1
fi

for attempt in $(seq 1 15); do
    after=$($COMPOSE logs backend 2>/dev/null | grep -cF "$MARKER")
    if [ "$after" -gt "$before" ]; then
        $COMPOSE logs backend 2>/dev/null | grep -F "$MARKER" | tail -n1 | awk '{print $NF}' | tr -d '\r'
        exit 0
    fi
    sleep 1
done

echo "No new code appeared in the backend log." >&2
exit 1
HELPEOF

sed -i "s|MULTICA_ADMIN_EMAIL|${ADMIN_EMAIL}|" /usr/local/bin/multica-login-code
chmod 755 /usr/local/bin/multica-login-code

echo "Configuring Nginx reverse proxy for HTTPS" | log
cat << EOF > /etc/nginx/sites-available/multica
server {
    listen 80;
    server_name ${CWM_DOMAIN};
    return 301 https://\$server_name\$request_uri;
}

server {
    listen 443 ssl http2;
    server_name ${CWM_DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${CWM_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${CWM_DOMAIN}/privkey.pem;

    # SSL security settings
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;

    # Attachment uploads
    client_max_body_size 100M;

    # WebSocket - must reach the backend directly, the Next.js rewrites only
    # forward plain HTTP and would drop the Upgrade handshake.
    location /ws {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
        proxy_read_timeout 86400;
    }

    # Everything else -> frontend, which rewrites /v1, /api, /auth and /uploads
    # to the backend server side.
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;

        # Timeouts
        proxy_connect_timeout 60s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
    }
}
EOF

ln -sf /etc/nginx/sites-available/multica /etc/nginx/sites-enabled/
rm -f /etc/nginx/sites-enabled/default 2>/dev/null
nginx -t && systemctl restart nginx
waitOrStop 0 "Nginx configuration or restart failed"

echo "Setting up automatic SSL certificate renewal" | log
systemctl enable certbot.timer
systemctl start certbot.timer

descriptionAppend " "
descriptionAppend "Multica installed successfully!"
descriptionAppend " "
descriptionAppend "Web UI: https://${CWM_DOMAIN}"
descriptionAppend "Multica version: ${version}"
descriptionAppend " "
descriptionAppend "LOGIN:"
descriptionAppend "   Email: ${ADMIN_EMAIL}"
descriptionAppend " "
descriptionAppend "Multica has no password - it signs in with a 6-digit code. No mail"
descriptionAppend "provider is configured, so nothing is emailed: the backend writes the"
descriptionAppend "code to its log. To get one, run this on the server:"
descriptionAppend "   multica-login-code"
descriptionAppend " "
descriptionAppend "Enter the email above, then the code it prints."
descriptionAppend " "
descriptionAppend "The account and its workspace already exist and onboarding is marked"
descriptionAppend "complete, so there is no Get Started step. Only ${ADMIN_EMAIL}"
descriptionAppend "can sign in - every other address is refused."
descriptionAppend " "
descriptionAppend "To have codes emailed instead, set RESEND_API_KEY in ${APP_DIR}/.env"
descriptionAppend "and run:"
descriptionAppend "   cd ${APP_DIR} && docker compose -f docker-compose.selfhost.yml up -d backend"
descriptionAppend " "
descriptionAppend "CLI / daemon (run on each team member's own machine):"
descriptionAppend " multica setup self-host --server-url https://${CWM_DOMAIN} --app-url https://${CWM_DOMAIN}"
descriptionAppend " "
descriptionAppend "Installation path: ${APP_DIR}"
descriptionAppend "Compose file: ${APP_DIR}/docker-compose.selfhost.yml"
descriptionAppend "Environment file: ${APP_DIR}/.env"
descriptionAppend "Nginx config: /etc/nginx/sites-available/multica"
descriptionAppend " "
descriptionAppend "PostgreSQL user: multica"
descriptionAppend "PostgreSQL password: ${POSTGRES_PASSWORD}"
descriptionAppend " "
descriptionAppend "Data lives in the multica_pgdata and multica_backend_uploads docker volumes."

tagScript success

exit 0
