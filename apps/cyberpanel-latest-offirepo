#!/bin/bash

if [ -f "include/startup.sh" ]; then
    . include/startup.sh
elif [ -f "../include/startup.sh" ]; then
    . ../include/startup.sh
fi

rootDir=$(rootDir)

echo "Downloading and installing ACME" | log
mkdir -p /root/.acme.sh/
cd /root/.acme.sh/
curlDownload https://raw.githubusercontent.com/acmesh-official/acme.sh/master/acme.sh
waitOrStop 0 "File not downloaded from official source"
chmod +x acme.sh

echo "Downloading and installing CyberPanel & OpenLiteSpeed" | log
mkdir -p /var/www/
cd /var/www/
curlDownload "https://cyberpanel.sh/?dl&Ubuntu" cyberpanel.sh
waitOrStop 0 "File not downloaded from official source"
chmod +x cyberpanel.sh
export DEBIAN_FRONTEND=noninteractive
bash cyberpanel.sh -v ols -a -p ${ADMINPASSWORD} > /root/cyberpanel.txt

olspass=$(cat /etc/cyberpanel/webadmin_passwd)

HTTPD_CONF=/usr/local/lsws/conf/httpd_config.conf
EX_VHCONF=/usr/local/lsws/conf/vhosts/Example/vhconf.conf
ACME=/root/.acme.sh/acme.sh
LE_DIR="/etc/letsencrypt/live/${CWM_DOMAIN}"
WEBROOT=/usr/local/lsws/Example/html
SSL_RETRY=/usr/local/bin/cwm-hostname-ssl-retry.sh

# Map the OLS :80 listener to the Example docroot (OLS ships :80 with no vhost
# mapped → 404, which would break the ACME HTTP-01 webroot challenge), and enable
# .htaccess rewrite on the Example vhost so the http→https redirect below applies.
# Both edits are simple block replacements; the `if old in ...` guards make them
# idempotent (the original block no longer matches after the first run).
echo "Mapping OLS :80 to ACME webroot and enabling http→https redirect" | log
python3 - "$HTTPD_CONF" "${CWM_DOMAIN}" "$EX_VHCONF" <<'PYEOF'
import sys
httpd, domain, vhconf = sys.argv[1], sys.argv[2], sys.argv[3]

s = open(httpd).read()
old = "listener Default{\n    address                  *:80\n    secure                   0\n}"
new = "listener Default{\n    address                  *:80\n    secure                   0\n    map                      Example %s\n}" % domain
if old in s:
    open(httpd, "w").write(s.replace(old, new, 1))

v = open(vhconf).read()
old = "rewrite {\n  enable 0\n  logLevel 0\n}"
new = "rewrite {\n  enable 1\n  autoLoadHtaccess 1\n  logLevel 0\n}"
if old in v:
    open(vhconf, "w").write(v.replace(old, new, 1))
PYEOF

# A bare-domain browser hits http:// first, and the :80 Example vhost would
# otherwise serve the OLS "Welcome" placeholder. Redirect everything on :80 to
# https://CWM_DOMAIN/ (the panel), while still serving the ACME challenge path.
cat <<EOF > ${WEBROOT}/.htaccess
RewriteEngine On
RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
RewriteRule ^(.*)\$ https://${CWM_DOMAIN}/\$1 [R=301,L]
EOF

systemctl restart lshttpd

# Obtain a Let's Encrypt cert for the hostname via webroot (no downtime).
#    The xip-style DNS used for CWM_DOMAIN is occasionally unresolvable by LE's
#    multi-perspective validators, so issuance can fail transiently. We keep the
#    issue→install logic in ONE place — the self-heal script below — and run it
#    once inline now. If it can't get a cert we fall back to self-signed (so OLS
#    can still bring up :443) and install a */20 cron that re-runs the same
#    script until DNS cooperates and a real cert lands.
mkdir -p "$LE_DIR"
"$ACME" --register-account -m "admin@${CWM_DOMAIN}" --server letsencrypt 2>&1 | log
"$ACME" --set-default-ca --server letsencrypt 2>&1 | log

cat <<EOF > "$SSL_RETRY"
#!/bin/bash
D="${CWM_DOMAIN}"
A="${ACME}"
LIVE="${LE_DIR}"
WR="${WEBROOT}"
remove_cron() { crontab -l 2>/dev/null | grep -v 'cwm-hostname-ssl-retry' | crontab - ; }
# Already holding a real cert? remove the cron and stop.
if openssl x509 -in "\$LIVE/fullchain.pem" -noout -issuer 2>/dev/null | grep -q "Let's Encrypt"; then
    remove_cron; exit 0
fi
if "\$A" --issue -d "\$D" -w "\$WR" -k ec-256 --server letsencrypt --force; then
    "\$A" --install-cert -d "\$D" --ecc \\
        --key-file "\$LIVE/privkey.pem" \\
        --fullchain-file "\$LIVE/fullchain.pem" \\
        --cert-file "\$LIVE/cert.pem" \\
        --reloadcmd "systemctl restart lscpd; systemctl restart lshttpd"
    openssl x509 -in "\$LIVE/fullchain.pem" -noout -issuer 2>/dev/null | grep -q "Let's Encrypt" && remove_cron
fi
EOF
chmod +x "$SSL_RETRY"

# Self-signed placeholder up front so the OLS :443 listener always has a cert to
# start with; the retry script overwrites it with the real cert on success.
if [ ! -f "${LE_DIR}/fullchain.pem" ]; then
    openssl req -x509 -nodes -days 3650 -newkey rsa:2048 \
        -keyout "${LE_DIR}/privkey.pem" -out "${LE_DIR}/fullchain.pem" \
        -subj "/CN=${CWM_DOMAIN}" 2>/dev/null
    cp "${LE_DIR}/fullchain.pem" "${LE_DIR}/cert.pem"
fi

# First attempt now; schedule the self-heal cron only if it didn't land a real cert.
"$SSL_RETRY" 2>&1 | log
if openssl x509 -in "${LE_DIR}/fullchain.pem" -noout -issuer 2>/dev/null | grep -q "Let's Encrypt"; then
    echo "LetsEncrypt certificate issued for ${CWM_DOMAIN}" | log
else
    echo "LetsEncrypt failed (flaky xip DNS); using self-signed and scheduling */20 retry" | log
    ( crontab -l 2>/dev/null | grep -v cwm-hostname-ssl-retry; \
      echo "*/20 * * * * $SSL_RETRY >> /var/log/cwm-ssl-retry.log 2>&1" ) | crontab -
fi
chmod 644 "${LE_DIR}/fullchain.pem" "${LE_DIR}/cert.pem"
chmod 600 "${LE_DIR}/privkey.pem"

# Point the lscpd (:8090) and OLS WebAdmin (:7080) certs at the hostname cert.
ln -sf "${LE_DIR}/fullchain.pem" /usr/local/lscp/conf/cert.pem
ln -sf "${LE_DIR}/privkey.pem"   /usr/local/lscp/conf/key.pem
ln -sf "${LE_DIR}/fullchain.pem" /usr/local/lsws/admin/conf/webadmin.crt
ln -sf "${LE_DIR}/privkey.pem"   /usr/local/lsws/admin/conf/webadmin.key

# Write the proxy vhost and the :443 listener (cert now exists).
echo "Configuring OpenLiteSpeed :443 reverse proxy for the panel" | log
mkdir -p /usr/local/lsws/conf/vhosts/cwmpanel
cat <<EOF > /usr/local/lsws/conf/vhosts/cwmpanel/vhconf.conf
docRoot                   ${WEBROOT}/
enableScript              1

extprocessor cyberpanel {
  type                    proxy
  address                 HTTPS://127.0.0.1:8090
  maxConns                100
  initTimeout             60
  retryTimeout            0
  respBuffer              0
  pcKeepAliveTimeout      60
}

context / {
  type                    proxy
  handler                 cyberpanel
  addDefaultCharset       off
}

vhssl  {
  keyFile                 ${LE_DIR}/privkey.pem
  certFile                ${LE_DIR}/fullchain.pem
  sslProtocol             24
}
EOF
chown -R lsadm:nogroup /usr/local/lsws/conf/vhosts/cwmpanel

if ! grep -q "virtualHost cwmpanel" "$HTTPD_CONF"; then
cat <<EOF >> "$HTTPD_CONF"

virtualHost cwmpanel {
  vhRoot                  /usr/local/lsws/Example/
  allowSymbolLink         1
  enableScript            1
  restrained              0
  configFile              conf/vhosts/cwmpanel/vhconf.conf
}

listener cwmSSL {
  address                 *:443
  secure                  1
  keyFile                 ${LE_DIR}/privkey.pem
  certFile                ${LE_DIR}/fullchain.pem
  map                     cwmpanel ${CWM_DOMAIN}
}
EOF
fi

# Make sure firewalld (now the active firewall) allows 80/443 on IPv4.
firewall-cmd --permanent --add-port=80/tcp --add-port=443/tcp 2>&1 | log
firewall-cmd --reload 2>&1 | log

systemctl restart lscpd
systemctl restart lshttpd
sleep 3
[ "$(systemctl is-active lshttpd)" = "active" ]
waitOrStop 0 "OpenLiteSpeed failed to start after :443 proxy config"

echo "Adding descriptions" | log
descriptionAppend "CyberPanel UI: https://${CWM_DOMAIN}/"
descriptionAppend "CyberPanel User: admin"
descriptionAppend "CyberPanel Password: ${ADMINPASSWORD}"
descriptionAppend " "
# OLS WebAdmin (:7080) is blocked at the network edge like :8090 — reachable
# only via an SSH tunnel, so we don't advertise it as a public URL.
descriptionAppend "OpenLiteSpeed WebAdmin (SSH tunnel to :7080): admin / ${olspass}"

tagScript success

exit 0
