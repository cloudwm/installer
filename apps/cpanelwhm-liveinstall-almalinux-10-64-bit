#!/bin/bash

if [ -f "include/startup.sh" ]; then
    . include/startup.sh
elif [ -f "../include/startup.sh" ]; then
    . ../include/startup.sh
fi

# Root password / datacenter come from the CWM provisioning config.
PASSWORD=$(grep -m1 '^password=' /root/guest.conf 2>/dev/null | cut -d= -f2-)

PRODUCTION="false"
DATACENTER=$(grep -m1 '^zone=' /root/guest.conf 2>/dev/null | cut -d= -f2-)
if [[ ! "$DATACENTER" =~ [Dd][Ee][Vv] ]]; then
    PRODUCTION="true"
fi

validate_environment() {
    echo "Validating environment..." | log

    [[ $EUID -eq 0 ]] || { echo "Must run as root, exiting (1)." | log 1; exit 1; }

    if [[ -d /usr/local/cpanel ]]; then
        echo "cPanel already installed, nothing to do." | log
        tagScript success
        exit 0
    fi

    [[ -f /etc/os-release ]] || { echo "Cannot detect OS, exiting (1)." | log 1; exit 1; }
    . /etc/os-release
    if [[ "$ID" != "almalinux" || ! "$VERSION_ID" =~ ^10 ]]; then
        echo "This installer requires AlmaLinux 10 (found ${ID} ${VERSION_ID}), exiting (1)." | log 1
        exit 1
    fi
    echo "Found supported OS: ${PRETTY_NAME}" | log
}

set_hostname() {
    # cPanel requires a fully-qualified hostname. When CWM_DOMAIN is set (normal
    # CWM provisioning) use cpanel.<domain>; otherwise keep the current hostname
    # if it is already an FQDN, so cPanel doesn't reject an invalid name like
    # "cpanel." (e.g. on a manual test box without /root/guest.conf).
    if [ -n "${CWM_DOMAIN}" ]; then
        local fqdn="cpanel.${CWM_DOMAIN}"
        hostnamectl set-hostname "$fqdn"
        echo "Hostname set to: $fqdn" | log
    else
        local current
        current="$(hostname -f 2>/dev/null || hostname)"
        if [[ "$current" == *.*.* || "$current" == *.* ]]; then
            echo "CWM_DOMAIN empty; keeping current FQDN hostname: ${current}" | log
        else
            hostnamectl set-hostname "cpanel.localdomain.local"
            echo "CWM_DOMAIN empty and current hostname '${current}' is not an FQDN; set to cpanel.localdomain.local" | log
        fi
    fi
}

prepare_system() {
    echo "Preparing AlmaLinux 10 for cPanel..." | log

    # cPanel & WHM does not support SELinux or firewalld — it manages its own
    # firewall. Disable both before installing so the installer doesn't abort.
    echo "Disabling SELinux..." | log
    setenforce 0 2>/dev/null || true
    sed -i 's/^SELINUX=.*/SELINUX=disabled/' /etc/selinux/config 2>/dev/null || true

    echo "Disabling firewalld (cPanel manages its own firewall)..." | log
    systemctl stop firewalld 2>/dev/null || true
    systemctl disable firewalld 2>/dev/null || true

    # NetworkManager must stay; cPanel supports it on AlmaLinux 10.
    # NOTE: do NOT pipe these verbose commands through '| log'. The framework's
    # log() ends in 'cat >/dev/ttyS0'; on hosts without a serial console that
    # reader dies immediately and the producer gets SIGPIPE (exit 141). Run them
    # directly so output goes to the console / their own logs. curl is omitted —
    # AlmaLinux ships curl-minimal, and pulling full curl can cause a conflict.
    echo "Updating system and installing prerequisites..." | log
    dnf -y update
    dnf -y install perl wget
    waitOrStop 0 "Failed to install prerequisites"
}

install_cpanel() {
    echo "Installing cPanel & WHM (this can take 30+ minutes)..." | log

    cd /home
    curl -so latest -L https://securedownloads.cpanel.net/latest
    waitOrStop 0 "Failed to download cPanel installer"

    # Run directly (not through '| log') so the 30+ min installer streams to the
    # console and cannot die from SIGPIPE on hosts without /dev/ttyS0. cPanel
    # keeps its own log at /var/log/cpanel-install.log.
    sh latest
    waitOrStop 0 "cPanel installation failed"

    if [[ ! -d /usr/local/cpanel ]]; then
        echo "cPanel installation did not complete (/usr/local/cpanel missing), exiting (1)." | log 1
        exit 1
    fi
    echo "cPanel & WHM installed successfully." | log
}

print_summary() {
    local ip fqdn whm_fqdn webmail_fqdn
    ip=$(hostname -I | awk '{print $1}')
    fqdn="cpanel.${CWM_DOMAIN}"
    whm_fqdn="whm.${CWM_DOMAIN}"
    webmail_fqdn="webmail.${CWM_DOMAIN}"

    cat > /etc/motd << EOF
================================================================================
                    cPanel Server - Installation Complete
================================================================================

WHM (Server Administration):
  https://${whm_fqdn}:2087   (or https://${ip}:2087)

  Username: root
  Password: ${PASSWORD}

--------------------------------------------------------------------------------

cPanel (User Control Panel):
  https://${fqdn}:2083

Webmail:
  https://${webmail_fqdn}:2096

--------------------------------------------------------------------------------

SERVER DETAILS:
  Hostname:   ${fqdn}
  IP Address: ${ip}
  OS:         AlmaLinux 10

================================================================================
EOF
    cat /etc/motd | log

    descriptionAppend "cPanel & WHM Installation Complete!"
    descriptionAppend ""
    descriptionAppend "WHM (admin): https://${whm_fqdn}:2087"
    descriptionAppend "cPanel:      https://${fqdn}:2083"
    descriptionAppend "Webmail:     https://${webmail_fqdn}:2096"
    descriptionAppend ""
    descriptionAppend "Username: root"
    descriptionAppend "Password: ${PASSWORD}"
    descriptionAppend ""
    descriptionAppend "Log in to WHM to complete the initial setup wizard."
}

main() {
    echo "Starting AlmaLinux 10 cPanel & WHM installer..." | log

    validate_environment
    set_hostname
    prepare_system
    install_cpanel
    print_summary

    echo "Install script completed successfully!" | log
    tagScript success
    exit 0
}

main
